SESSIONS_TMPL = r'''
umask 077
echo "BASHD_JOBS"
tmux -L bashd list-sessions -F '#S' 2>/dev/null | sort > /tmp/.bashd_sess.$$ || : > /tmp/.bashd_sess.$$
haveflock=0; command -v flock >/dev/null 2>&1 && haveflock=1
ref="/tmp/.bashd_ref.$$"
[ "$haveflock" = 1 ] && { touch -d "@$(( $(date +%s) - __GRACE__ ))" "$ref" 2>/dev/null || ref=""; }
now=$(date +%s)
for d in "$HOME"/.bashd/jobs/*/; do
  [ -d "$d" ] || continue
  c="-"; [ -f "$d/code" ] && c=$(cat "$d/code")
  s="-"; [ -f "$d/session" ] && s=$(cat "$d/session")
  if [ "$c" = "-" ] && [ -f "$d/lock" ]; then
    if [ "$s" = "-" ] || ! grep -qx "$s" /tmp/.bashd_sess.$$; then
      echo 143 > "$d/code"; c=143
    elif [ "$haveflock" = 1 ] && [ -n "$ref" ] && [ "$d/lock" -ot "$ref" ] \
      && [ ! "$d/out" -nt "$ref" ] && [ ! "$d/err" -nt "$ref" ] \
      && flock -n "$d/lock" true 2>/dev/null; then
      # v0.3.1 orphan rule — same as in JOB_READ_TMPL
      busy=0
      for jl in "$HOME"/.bashd/jobs/*/lock; do
        [ -f "$jl" ] || continue
        jd=$(dirname "$jl")
        [ "$(cat "$jd/session" 2>/dev/null)" = "$s" ] || continue
        [ -f "$jd/code" ] && continue
        flock -n "$jl" true 2>/dev/null || { busy=1; break; }
      done
      if [ "$busy" = 0 ]; then echo 143 > "$d/code"; c=143; fi
    fi
  fi
  o=0; e=0
  [ -f "$d/out" ] && o=$(wc -c < "$d/out" | tr -d " ")
  [ -f "$d/err" ] && e=$(wc -c < "$d/err" | tr -d " ")
  age="-"
  [ -f "$d/lock" ] && age=$((now - $(stat -c %Y "$d/lock" 2>/dev/null || echo "$now")))
  cmd=$(head -n 1 "$d/run" 2>/dev/null | cut -c1-100 | tr "\t\r" "  ")
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(basename "$d")" "$c" "$o" "$e" "$s" "$age" "$cmd"
done
