echo "BASHD_TTYS"
tmux -L bashd list-sessions -F '#S' 2>/dev/null || true
echo "BASHD_TTYLOGS"
for l in "$HOME"/.bashd/tmux/*.log; do
  [ -f "$l" ] || continue
  printf '%s\t%s\n' "$(basename "$l" .log)" "$(wc -c < "$l" | tr -d " ")"
done
echo "BASHD_DONE"
