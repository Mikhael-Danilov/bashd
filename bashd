def _submit_ops(jid, cmd, cwd, env):
    """Lines to type into the persistent session shell so cmd runs INSIDE it
    (cd/export persist) with output captured to the job's files. $HOME expands
    in the session shell; every usage of $D is pre-quoted here."""
    J = "$HOME/.bashd/jobs/" + jid
    lines = ['D="%s"; : >"$D/out"; : >"$D/err"' % J]
    if env:
        lines.append("export " + " ".join("%s=%s" % (k, shq(v)) for k, v in sorted(env.items())))
    if cwd:
        lines.append("cd %s || { echo 97 >\"$D/code\"; }" % shq(cwd))
    delim = "BASHD_D_" + secrets.token_hex(4)
    printable = all(ch.isprintable() or ch == "\t" for ch in cmd)
    maxline = max((len(x) for x in cmd.split("\n")), default=0)
    if cmd and len(cmd) <= 2000 and maxline <= 500 and printable:
        lines.append("cat >\"$D/run\" <<'%s'" % delim)
        lines.extend(cmd.split("\n"))
        lines.append(delim)
    else:  # arbitrary bytes / very long lines: base64 keeps tty lines short
        lines.append("base64 -d >\"$D/run\" <<'%s'" % delim)
        b = base64.b64encode(cmd.encode()).decode()
        lines.extend(b[i:i + 76] for i in range(0, len(b), 76))
        lines.append(delim)
    # eval and code-capture are SEPARATE typed lines: if the command is
    # Ctrl-C'd, bash aborts the rest of the current input line, so the capture
    # must live on its own line to still record the (130) code afterwards.
    lines.append('[ -f "$D/code" ] || eval "$(cat "$D/run")" >"$D/out" 2>"$D/err"')
    lines.append('rc=$?; [ -f "$D/code" ] || echo "$rc" >"$D/code"')
    return lines


def _send_keys_lines(sess, lines):
    out = []
    for ln in lines:
        if ln:
            out.append('  tmux -L bashd send-keys -t %s -l -- %s' % (sess, shq(ln)))
        out.append('  tmux -L bashd send-keys -t %s Enter' % sess)
    return out


def _check_sess_name(s):
    if not ID_RE.match(s or ""):
        raise BashdError("bad session name %r (allowed: [A-Za-z0-9_-])" % s)
    return s


def job_start(host, jid, cmd, cwd=None, env=None, ulimit_mb=None, session="main", dry_run=False):
    _check_sess_name(session)
    if ulimit_mb is None:
        ulimit_mb = host.defaults.get("ulimit_mb", DEFAULT_ULIMIT_MB)
    init = "ulimit -f %d 2>/dev/null; export BASHD_SESSION=%s" % (int(ulimit_mb) * 1024, shq(session))
    script = ((SESS_ENSURE + SESS_BUSYCLEAR)
              .replace("__SESS__", session).replace("__INIT__", shq(init)))
    script += (JOB_SUBMIT_TAIL.replace("__SESS__", session).replace("__ID__", jid)
               .replace("__SENDOPS__",
                        "\n".join(_send_keys_lines(session, _submit_ops(jid, cmd, cwd, env)))))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=60)[1]
    m = re.search(r"BASHD_RESULT (\S+)", out)
    state = m.group(1) if m else "unknown"
    if state == "no-tmux":
        raise BashdError("tmux is not installed on host %r (required in v0.2: all modes "
                         "run inside persistent tmux sessions)" % host.name)
    if state in ("error", "tmux-fail"):
        raise BashdError("job start failed on %s (session %s)" % (host.name, session))
    return state


def _b64d(s):
    if not s:
        return b""
    return base64.b64decode(s)


def _code_to_int(c):
    if c is None or c in ("-", ""):
        return None
    try:
        return int(c)
    except ValueError:
        return None


# ---------------------------------------------------------------- job substrate ops


def exec_argv_preview(host, script):
    if host.local:
        return {"argv": ["/bin/sh", "-s"], "stdin": script}
    return {"argv": _ssh_argv_for_path(host, host.paths[0]), "stdin": script}


def job_read(host, jid, cursor_out=0, cursor_err=0, max_bytes=DEFAULT_MAX_BYTES, dry_run=False):
    script = (JOB_READ_TMPL.replace("__ID__", jid)
              .replace("__CO__", str(int(cursor_out)))
              .replace("__CE__", str(int(cursor_err)))
              .replace("__MAX__", str(int(max_bytes))))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=60)[1].strip()
    if "BASHD_ENOENT" in out.splitlines()[-1] if out else False:
        raise NotFound("no such job %r on %s" % (jid, host.name))
    try:
        line = out.splitlines()[-1] if out else ""
        env = json.loads(line)
    except (ValueError, IndexError):
        raise BashdError("job read: bad envelope from %s: %r" % (host.name, out[-200:]))
    ob, eb = _b64d(env["out"]), _b64d(env["err"])
    return {"status": "done" if env["code"] not in ("-", "") else "running",
            "exit_code": _code_to_int(env["code"]),
            "alive": bool(int(env.get("alive", 1))),
            "stdout": ob.decode("utf-8", "replace"),
            "stderr": eb.decode("utf-8", "replace"),
            "cursor_out": cursor_out + len(ob),
            "cursor_err": cursor_err + len(eb),
            "out_size": int(env["out_size"]), "err_size": int(env["err_size"])}


def job_signal(host, jid, sig="TERM", dry_run=False):
    signum = _signal.Signals["SIG" + sig].value if isinstance(sig, str) else int(sig)
    script = (JOB_SIGNAL_TMPL.replace("__ID__", jid).replace("__SIGNUM__", str(signum)))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=30)[1]
    m = re.search(r"BASHD_RESULT (\S+)", out)
    return {"action": m.group(1) if m else "unknown"}


# ---------------------------------------------------------------- tty substrate ops

def session_ensure(host, name, ulimit_mb=None, dry_run=False):
    """Create the persistent session if missing (init line: ulimit + marker var)."""
    _check_sess_name(name)
    if ulimit_mb is None:
        ulimit_mb = host.defaults.get("ulimit_mb", DEFAULT_ULIMIT_MB)
    init = "ulimit -f %d 2>/dev/null; export BASHD_SESSION=%s" % (int(ulimit_mb) * 1024, shq(name))
    script = SESS_ENSURE.replace("__SESS__", name).replace("__INIT__", shq(init))
    script += 'echo "BASHD_RESULT ok"\n'
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=60)[1]
    m = re.search(r"BASHD_RESULT (\S+)", out)
    state = m.group(1) if m else "unknown"
    if state == "no-tmux":
        raise BashdError("tmux is not installed on host %r (required in v0.2: all modes "
                         "run inside persistent tmux sessions)" % host.name)
    if state == "tmux-fail":
        raise BashdError("session create failed on %s (%s)" % (host.name, name))
    return state


def tty_read(host, name, cursor=0, max_bytes=DEFAULT_MAX_BYTES, screen=False, dry_run=False):
    script = (TTY_READ_TMPL.replace("__NAME__", name)
              .replace("__CO__", str(int(cursor)))
              .replace("__MAX__", str(int(max_bytes)))
              .replace("__SCREEN__", "1" if screen else "0"))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=60)[1].strip()
    try:
        env = json.loads(out.splitlines()[-1] if out else "{}")
    except ValueError:
        raise BashdError("tty read: bad envelope from %s: %r" % (host.name, out[-200:]))
    ob = _b64d(env.get("out", ""))
    chunk = ob.decode("utf-8", "replace")
    return {"alive": bool(env.get("alive")),
            "stdout": chunk, "cursor": cursor + len(ob),
            "size": int(env.get("size", 0)),
            "screen": _b64d(env.get("screen", "")).decode("utf-8", "replace")}


def tty_write(host, name, data, append_newline=True, dry_run=False):
    script = (TTY_WRITE_TMPL.replace("__NAME__", name)
              .replace("__DATA__", shq(data))
              .replace("__ENTER__", "" if append_newline is False else ""))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=30)[1]
    return {"written": len(data),
            "ok": "BASHD_RESULT ok" in out}


def tty_signal(host, name, mode, dry_run=False):
    script = (TTY_SIGNAL_TMPL.replace("__NAME__", name).replace("__MODE__", mode))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=30)[1]
    m = re.search(r"BASHD_RESULT (\S+)", out)
    return {"action": m.group(1) if m else "unknown"}


# ---------------------------------------------------------------- high-level ops

def _tail_cap(s, cap):
    if len(s) <= cap:
        return s, 0
    dropped = len(s) - cap
    return s[dropped:], dropped


def do_run(host, cmd, timeout_s=120, max_bytes=DEFAULT_MAX_BYTES, cwd=None, env=None,
           jid=None, ulimit_mb=None, session="main", dry_run=False):
    if dry_run:
        return job_start(host, "previewid", cmd, cwd, env, ulimit_mb, session=session, dry_run=True)
    jid = jid or new_id()
    t0 = time.time()
    # Mid-command failover at entry: if every path is down right now, keep
    # retrying the submit for a short grace — it is idempotent by id, and the
    # substrate tolerates it landing late.
    grace = min(15.0, max(1.0, timeout_s))
    submit_retries = 0
    while True:
        try:
            state = job_start(host, jid, cmd, cwd, env, ulimit_mb, session=session)
            break
        except Unreachable:
            if time.time() - t0 >= grace:
                raise
            submit_retries += 1
            time.sleep(1.0)
    res = {"ok": True, "id": "%s:%s" % (host.name, jid), "host": host.name,
           "start_state": state, "status": "running", "exit_code": None,
           "stdout": "", "stderr": "", "cursor_out": 0, "cursor_err": 0,
           "duration_s": None, "timed_out": False, "note": host.notes}
    if submit_retries:
        res["submit_retries"] = submit_retries
    if state == "done-exists":
        r = job_read(host, jid, 0, 0, max_bytes * 4)
        res.update(status=r["status"], exit_code=r["exit_code"], stdout=r["stdout"],
                   stderr=r["stderr"], cursor_out=r["cursor_out"], cursor_err=r["cursor_err"])
        return res
    poll = POLL_LOCAL if host.local else POLL_REMOTE
    acc_o = acc_e = ""
    link_drops = 0
    while True:
        time.sleep(poll)
        try:
            r = job_read(host, jid, res["cursor_out"], res["cursor_err"], READ_CHUNK)
        except (Unreachable, BashdError) as e:
            link_drops += 1
            if time.time() - t0 >= timeout_s:
                res["dropped_link"] = str(e)
                res["link_drops"] = link_drops
                break
            time.sleep(min(1.0 * link_drops, 5.0))
            continue
        if link_drops:
            res["link_recovered"] = True
            res["link_drops"] = link_drops
            link_drops = 0
        res["cursor_out"], res["cursor_err"] = r["cursor_out"], r["cursor_err"]
        acc_o += r["stdout"]
        acc_e += r["stderr"]
        if len(acc_o) > ACC_CAP:
            acc_o = acc_o[-ACC_CAP:]
        if len(acc_e) > ACC_CAP:
            acc_e = acc_e[-ACC_CAP:]
        if r["status"] == "done":
            res["status"] = "done"
            res["exit_code"] = r["exit_code"]
            res["duration_s"] = round(time.time() - t0, 3)
            break
        if not r.get("alive", True):
            res["status"] = "dead"
            res["duration_s"] = round(time.time() - t0, 3)
            break
        if time.time() - t0 >= timeout_s:
            res["timed_out"] = True
            break
    acc_o, dropped_o = _tail_cap(acc_o, max_bytes * 8)
    acc_e, dropped_e = _tail_cap(acc_e, max_bytes * 8)
    res["stdout"], res["stderr"] = acc_o, acc_e
    if dropped_o:
        res["stdout_dropped_head_bytes"] = dropped_o
    if dropped_e:
        res["stderr_dropped_head_bytes"] = dropped_e
    return res


def do_wait(host, kind, key, timeout_s=120, until="exit", pattern=None, idle_s=2.0,
            max_bytes=DEFAULT_MAX_BYTES, until_reachable=False, dry_run=False):
    if dry_run:
        return {"dry_run": "wait is runtime-only"}
    rx = re.compile(pattern, re.MULTILINE) if pattern else None
    if rx is None and until == "regex":
        raise BashdError("until=regex requires --pattern")
    t0 = time.time()
    deadline = t0 + timeout_s
    if kind == "job":
        read = lambda co, ce: job_read(host, key, co, ce, READ_CHUNK)
    else:
        read = lambda co, ce: tty_read(host, key, co, READ_CHUNK)

    cur_o = cur_e = 0
    try:
        first = read(0, 0)
        if kind == "job":
            cur_o = max(0, first["out_size"] - KEEP_WINDOW)
            cur_e = max(0, first.get("err_size", 0) - KEEP_WINDOW)
        else:
            cur_o = max(0, first["size"] - KEEP_WINDOW)
        entry_unreachable = None
    except (Unreachable, BashdError) as e:
        if not until_reachable:
            raise
        first, entry_unreachable = None, str(e)

    acc = ""
    last_change = time.time()
    code = None
    alive = True
    match = None
    poll = POLL_LOCAL if host.local else POLL_REMOTE
    backoff = 1.0
    link_drops = 0
    status = "running"
    while True:
        if entry_unreachable is not None:
            try:
                first = read(0, 0)
                cur_o = max(0, first["out_size"] - KEEP_WINDOW)
                cur_e = max(0, first.get("err_size", 0) - KEEP_WINDOW)
                sizes = (first["out_size"], first.get("err_size", 0))
                entry_unreachable = None
            except (Unreachable, BashdError):
                if time.time() >= deadline:
                    raise Unreachable("still unreachable after %ss: %s" % (timeout_s, entry_unreachable))
                time.sleep(min(backoff, max(0.1, deadline - time.time())))
                backoff = min(backoff * 2, 5)
                continue
        time.sleep(poll)
        try:
            if kind == "job":
                r = read(cur_o, cur_e)
                new = r["stdout"] + r["stderr"]
                cur_o, cur_e = r["cursor_out"], r["cursor_err"]
                code = r["exit_code"]
                alive = r.get("alive", True)
            else:
                r = read(cur_o, 0)
                new = r["stdout"]
                cur_o = r["cursor"]
                alive = r["alive"]
            backoff = 1.0
        except (Unreachable, BashdError) as e:
            link_drops += 1
            if time.time() >= deadline:
                res = {"ok": True, "status": "running", "link_lost": True,
                       "link_error": str(e), "waited_s": round(time.time() - t0, 2)}
                if link_drops:
                    res["link_drops"] = link_drops
                return _wait_result(res, acc, max_bytes, match)
            time.sleep(min(backoff, max(0.1, deadline - time.time())))
            backoff = min(backoff * 2, 5)
            continue
        if new:
            acc += new
            if len(acc) > ACC_CAP:
                acc = acc[-ACC_CAP:]
            last_change = time.time()
        if rx is not None:
            m = rx.search(acc)
            if m:
                match = m.group(0)
                break
        if until == "exit" and (code is not None or not alive):
            break
        if until == "idle" and (time.time() - last_change) >= idle_s:
            break
        if time.time() >= deadline:
            break
    waited = round(time.time() - t0, 2)
    if code is not None:
        status = "done"
    elif not alive:
        status = "dead"
    else:
        status = "running"
    res = {"ok": True, "status": status, "exit_code": code, "waited_s": waited}
    if link_drops:
        res["link_drops"] = link_drops
        res["link_recovered"] = True
    return _wait_result(res, acc, max_bytes, match)


def _wait_result(res, acc, max_bytes, match):
    acc, dropped = _tail_cap(acc, max_bytes)
    if dropped:
        res["dropped_head_bytes"] = dropped
    res["stdout"] = acc
    if match:
        res["match"] = match
    return res


def do_start(host, cmd=None, mode="batch", name=None, cwd=None, env=None, jid=None,
             session=None, dry_run=False):
    if mode == "tty" and not cmd:
        sname = _check_sess_name(session or name or ("s" + secrets.token_hex(3)))
        state = session_ensure(host, sname, dry_run=dry_run)
        return {"ok": True, "id": "%s:tty:%s" % (host.name, sname), "mode": "tty",
                "session": sname, "state": state, "host": host.name, "note": host.notes}
    if not cmd:
        raise BashdError("start requires cmd (or mode=tty without cmd for a bare session)")
    sname = _check_sess_name(session or name or "main")
    jid = jid or new_id()
    state = job_start(host, jid, cmd, cwd, env, session=sname, dry_run=dry_run)
    return {"ok": True, "id": "%s:%s" % (host.name, jid), "mode": mode,
            "session": sname, "state": state, "host": host.name, "note": host.notes}


def do_read(host, kind, key, cursor_out=0, cursor_err=0, max_bytes=DEFAULT_MAX_BYTES,
            screen=False, dry_run=False):
    if kind == "job":
        r = job_read(host, key, cursor_out, cursor_err, max_bytes, dry_run=dry_run)
        if dry_run:
            return r
        return {"ok": True, "id": "%s:%s" % (host.name, key), "host": host.name, **r}
    r = tty_read(host, key, cursor_out, max_bytes, screen, dry_run=dry_run)
    if dry_run:
        return r
    out = {"ok": True, "id": "%s:tty:%s" % (host.name, key), "host": host.name,
           "alive": r["alive"], "status": "alive" if r["alive"] else "dead",
           "stdout": r["stdout"], "cursor_out": r["cursor"],
           "out_size": r["size"], "err_size": 0}
    if screen:
        out["screen"] = r["screen"]
    return out


def do_write(host, kind, key, data, append_newline=True, dry_run=False):
    if kind != "tty":
        raise BashdError("write is only supported on tty sessions (id host:tty:name)")
    return {"ok": True, **tty_write(host, key, data, append_newline, dry_run=dry_run)}


def do_signal(host, kind, key, sig="TERM", dry_run=False):
    if kind == "job":
        return {"ok": True, "id": "%s:%s" % (host.name, key), **job_signal(host, key, sig, dry_run=dry_run)}
    mode = "ctrl-c" if sig.upper() in ("INT", "CTRL-C", "C-C") else "kill"
    return {"ok": True, "id": "%s:tty:%s" % (host.name, key), **tty_signal(host, key, mode, dry_run=dry_run)}


def _probe_host(name, host):
    try:
        rc, out, err = exec_script(host, SESSIONS_TMPL, timeout_s=15)
        if rc != 0:
            return {"host": name, "reachable": True, "error": "remote script rc=%s %s" % (rc, err[-200:])}
        jobs, ttys = [], []
        section = None
        tmux_names = []
        for line in out.splitlines():
            if line == "BASHD_JOBS":
                section = "jobs"
            elif line == "BASHD_TTYS":
                section = "tty_names"
            elif line == "BASHD_TTYLOGS":
                section = "tty_logs"
            elif line == "BASHD_DONE":
                break
            elif section == "jobs":
                p = line.split("\t")
                if len(p) == 5:
                    jobs.append({"id": "%s:%s" % (name, p[0]), "running": p[1] == "-",
                                 "exit_code": _code_to_int(p[1]), "out_bytes": int(p[2]),
                                 "err_bytes": int(p[3]), "session": p[4]})
            elif section == "tty_names":
                if line.strip():
                    tmux_names.append(line.strip())
            elif section == "tty_logs":
                p = line.split("\t")
                if len(p) == 2:
                    ttys.append({"name": p[0], "id": "%s:tty:%s" % (name, p[0]),
                                 "alive": p[0] in tmux_names, "log_bytes": int(p[1])})
        return {"host": name, "reachable": True, "path": "local" if host.local else "ssh",
                "note": host.notes, "jobs": jobs, "ttys": ttys}
    except Unreachable as e:
        return {"host": name, "reachable": False, "error": str(e)}
    except BashdError as e:
        return {"host": name, "reachable": False, "error": str(e)}


def do_sessions(host_name=None, hosts=None):
    hosts = hosts or load_config()
    if host_name:
        targets = {host_name: get_host(host_name, hosts)}
    else:
        targets = hosts
    with ThreadPoolExecutor(max_workers=min(8, len(targets) or 1)) as ex:
        results = list(ex.map(lambda kv: _probe_host(kv[0], kv[1]), sorted(targets.items())))
    return {"ok": True, "hosts": results}


def do_prune(host, host_name, dry_run=False, stale_s=None):
    """Remove finished job dirs and tty logs whose tmux session is dead.
    Before removal, a codeless job whose session is gone is finalized as 143
    (it can never finish: target reboot or killed session). With stale_s, a
    codeless job whose out/err have BOTH been quiet for stale_s seconds is
    finalized too — the session-alive-but-wedged case; opt-in because a
    legitimately silent long run could match."""
    script = r'''
umask 077
n=0
tmux -L bashd list-sessions -F '#S' 2>/dev/null | sort > /tmp/.bashd_alive.$$ || : > /tmp/.bashd_alive.$$
__STALE_INIT__
for d in "$HOME"/.bashd/jobs/*/; do
  [ -d "$d" ] || continue
  if [ ! -f "$d/code" ] && [ -f "$d/lock" ]; then
    s=$(cat "$d/session" 2>/dev/null)
    dead=0
    if [ -z "$s" ] || ! grep -qx "$s" /tmp/.bashd_alive.$$; then dead=1; fi
__STALE_CHECK__
    [ "$dead" = 1 ] && echo 143 > "$d/code"
  fi
  if [ -f "$d/code" ]; then rm -rf "$d" && n=$((n+1)); fi
done
t=0
for l in "$HOME"/.bashd/tmux/*.log; do
  [ -f "$l" ] || continue
  b=$(basename "$l" .log)
  grep -qx "$b" /tmp/.bashd_alive.$$ || { rm -f "$l" && t=$((t+1)); }
done
rm -f /tmp/.bashd_alive.$$
echo "BASHD_PRUNED jobs=$n logs=$t"
'''
    if stale_s:
        script = script.replace(
            "__STALE_INIT__",
            'ref="/tmp/.bashd_stale.$$"; '
            'touch -d "@$(( $(date +%s) - __STALE_SECS__ ))" "$ref" 2>/dev/null || ref=""; '
        ).replace("__STALE_SECS__", str(max(1, int(stale_s)))).replace(
            "__STALE_CHECK__",
            '    if [ "$dead" = 0 ] && [ -n "$ref" ] && [ "$d/out" -ot "$ref" ] '
            '&& [ "$d/err" -ot "$ref" ]; then dead=1; fi\n')
    script = script.replace("__STALE_INIT__", "").replace("__STALE_CHECK__", "")
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=60)[1]
    m = re.search(r"BASHD_PRUNED jobs=(\d+) logs=(\d+)", out)
    if not m:
        raise BashdError("prune: unexpected output from %s" % host_name)
    res = {"ok": True, "host": host_name, "jobs_removed": int(m.group(1)),
           "tty_logs_removed": int(m.group(2))}
    if stale_s:
        res["stale_s"] = int(stale_s)
    return res


def do_hosts():
    return {"ok": True, "hosts": [h.describe() for _, h in sorted(load_config().items())]}


def do_paths(host_name=None, repath=False):
    """Per-host route table: paths with costs, sticky/cheapest, probe state.
    repath=True probes paths cheaper than the current sticky one right now."""
    hosts = load_config()
    targets = {host_name: get_host(host_name, hosts)} if host_name else hosts
    res = {"ok": True, "hosts": []}
    for name in sorted(targets):
        h = targets[name]
        rep = repath_probe(h) if (repath and not h.local and len(h.paths) > 1) else None
        st = load_state()
        si = (st.get("path") or {}).get(name)
        pr = (st.get("probe") or {}).get(name) or {}
        entry = {"host": name, "local": h.local, "sticky": si,
                 "cheapest": cheapest_path_idx(h),
                 "probe_backoff_s": pr.get("backoff"),
                 "probe_next_in_s": (round(pr["next_ts"] - time.time(), 1)
                                     if pr.get("next_ts") else None),
                 "paths": [{"idx": i, "cost": p.get("cost", i), "sticky": i == si,
                            "desc": _path_desc(p)} for i, p in enumerate(h.paths)]}
        if rep:
            entry["repath"] = rep
        res["hosts"].append(entry)
    return res


