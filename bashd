# signal = Ctrl-C into the job's session. Interactive bash DISCARDS pending
# input on SIGINT (the code-capture line would be eaten), so after a short
# grace we write 128+2 ourselves if the shell hasn't.
JOB_SIGNAL_TMPL = r'''
d="$HOME/.bashd/jobs/__ID__"
if [ -f "$d/code" ]; then echo "BASHD_RESULT dead"; exit 0; fi
S=$(cat "$d/session" 2>/dev/null)
if [ -z "$S" ] || ! tmux -L bashd has-session -t $S 2>/dev/null; then
  echo "$((128 + __SIGNUM__))" > "$d/code"
  echo "BASHD_RESULT dead"; exit 0
fi
tmux -L bashd send-keys -t $S C-c
i=0
while [ $i -lt 10 ] && ! [ -f "$d/code" ]; do sleep 0.3; i=$((i+1)); done
[ -f "$d/code" ] || echo 130 > "$d/code"
echo "BASHD_RESULT ctrl-c"
'''

