if [ "__MODE__" = ctrl-c ]; then
  tmux -L bashd send-keys -t __NAME__ C-c && echo "BASHD_RESULT ctrl-c" || echo "BASHD_RESULT dead"
else
  tmux -L bashd kill-session -t __NAME__ 2>/dev/null && echo "BASHD_RESULT killed" || echo "BASHD_RESULT dead"
