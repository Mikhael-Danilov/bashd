log="$HOME/.bashd/tmux/__NAME__.log"
s=0
[ -f "$log" ] && s=$(wc -c < "$log" | tr -d " ")
a=0
tmux -L bashd has-session -t __NAME__ 2>/dev/null && a=1
b=$(tail -c +$((__CO__ + 1)) "$log" 2>/dev/null | head -c __MAX__ | base64 | tr -d "\n")
sc=""
if [ "__SCREEN__" = 1 ]; then
  sc=$(tmux -L bashd capture-pane -t __NAME__ -p 2>/dev/null | base64 | tr -d "\n")
fi
printf '{"size":%s,"alive":%s,"out":"%s","screen":"%s"}\n' "$s" "$a" "$b" "$sc"
'''

TTY_WRITE_TMPL = r'''
