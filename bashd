MCP_PROTOCOL_VERSION = "2024-11-05"


def _schema(props, required=None):
    return {"type": "object", "properties": props,
            "required": required or []}


def _s(t, desc, **kw):
    d = {"type": t, "description": desc}
    d.update(kw)
    return d


