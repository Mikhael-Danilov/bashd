VERSION = "0.4.1"
ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
ENVKEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
DEFAULT_MAX_BYTES = 16384      # per-stream bytes returned per read
READ_CHUNK = 65536             # bytes fetched per poll inside wait loops
KEEP_WINDOW = 65536            # wait(): start reading this far back from EOF
ACC_CAP = 262144               # wait()/run() accumulation cap before dropping head
POLL_LOCAL = 0.2
POLL_REMOTE = 0.5
DEFAULT_ULIMIT_MB = 512        # per-stream file size cap for batch jobs (0 = off)
PROBE_MIN_BACKOFF = 30.0      # s between auto repath probes (doubles on failure)
PROBE_MAX_BACKOFF = 900.0     # cap for the probe backoff growth
ORPHAN_GRACE_S = 900          # a codeless job younger than this is never orphan-finalized

HOME_DIR = os.environ.get("BASHD_HOME", os.path.expanduser("~/.bashd"))

EXIT_OK, EXIT_ERR, EXIT_UNREACHABLE, EXIT_NOTFOUND, EXIT_RUNNING = 0, 1, 2, 3, 10


class BashdError(Exception):
    code = EXIT_ERR


class Unreachable(BashdError):
    code = EXIT_UNREACHABLE


class NotFound(BashdError):
    code = EXIT_NOTFOUND


def eprint(*a):
    print(*a, file=sys.stderr, flush=True)


def shq(s):
    return "'" + str(s).replace("'", "'\\''") + "'"


def set_home(p):
    global HOME_DIR
    HOME_DIR = p


# ---------------------------------------------------------------- config

DEFAULT_CONNECT = {"timeout_s": 8, "keepalive_s": 15, "keepalive_max": 3,
                   "strict_host_keys": "accept-new", "control_master": True}


class Host:
    def __init__(self, name, cfg):
        if not ID_RE.match(name):
            raise BashdError("bad host alias %r (allowed: [A-Za-z0-9_-], no ':')" % name)
        self.name = name
        self.local = name == "local" and not cfg.get("ssh")
        self.ssh = cfg.get("ssh")            # user@host, host, or ssh-config alias
        # paths: "direct" | ssh-args (str/list) | {"args": [..], "cost": n} |
        #   {"hop": "<ssh-target>", "hop_args": "<inner ssh args, e.g. -i k>",
        #    "target": "<inner dst>", "cost": n}
        # "cost" (lower = preferred) may ride on any dict form; default cost =
        # position, so config order IS the preference order.
        paths = cfg.get("paths") or ["direct"]
        self.paths = []
        for p in paths:
            cost = p.get("cost") if isinstance(p, dict) else None
            if cost is not None and not isinstance(cost, (int, float)):
                raise BashdError("bad path cost %r on host %r (want number)" % (cost, name))
            if p == "direct":
                self.paths.append({"type": "args", "args": []})
            elif isinstance(p, dict) and "hop" in p:
                self.paths.append({"type": "hop", "hop": p["hop"],
                                   "hop_args": shlex.split(p.get("hop_args", "")),
                                   "target": p.get("target") or cfg.get("ssh")})
            elif isinstance(p, dict) and "args" in p:
                self.paths.append({"type": "args", "args": [str(x) for x in p["args"]]})
            elif isinstance(p, list):
                self.paths.append({"type": "args", "args": [str(x) for x in p]})
            else:
                self.paths.append({"type": "args", "args": shlex.split(str(p))})
            if cost is not None:
                self.paths[-1]["cost"] = cost
        c = dict(DEFAULT_CONNECT)
        c.update(cfg.get("connect") or {})
        self.connect = c
        self.defaults = cfg.get("defaults") or {}
        self.notes = cfg.get("notes") or ""

    def describe(self):
        def rp(p):
            d = _path_desc(p)
            if "cost" in p:
                d += " (cost %s)" % p["cost"]
            return d
        return {"name": self.name, "local": self.local, "ssh": self.ssh,
                "paths": [rp(p) for p in self.paths],
                "connect": self.connect, "defaults": self.defaults, "notes": self.notes}


def load_config():
    path = os.path.join(HOME_DIR, "hosts.json")
    hosts = {"local": Host("local", {})}
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        for name, cfg in (data.get("hosts") or {}).items():
            hosts[name] = Host(name, cfg)
    return hosts


def get_host(name, hosts=None):
    hosts = hosts or load_config()
    if name not in hosts:
        raise NotFound("unknown host %r (known: %s)" % (name, ", ".join(sorted(hosts))))
    return hosts[name]


def load_state():
    path = os.path.join(HOME_DIR, "state.json")
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def save_state(st):
    os.makedirs(HOME_DIR, exist_ok=True)
    path = os.path.join(HOME_DIR, "state.json")
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        json.dump(st, f)
    os.replace(path + ".tmp", path)


def note_sticky_path(host, idx):
    st = load_state()
    st.setdefault("path", {})[host.name] = idx
    save_state(st)


def sticky_path_idx(host):
    return load_state().get("path", {}).get(host.name)


def _path_desc(p):
    if p["type"] == "args":
        return "direct" if not p["args"] else " ".join(p["args"])
    return "hop via %s -> %s" % (p["hop"], p["target"])


def cheapest_path_idx(host):
    """Cost wins; config position breaks ties (unset cost = position)."""
    return min(range(len(host.paths)),
               key=lambda i: (host.paths[i].get("cost", i), i))


def _arm_probe(host, failed):
    st = load_state()
    pr = (st.get("probe") or {}).get(host.name) or {}
    if failed:
        b = min(max(pr.get("backoff", PROBE_MIN_BACKOFF) * 2, PROBE_MIN_BACKOFF),
                PROBE_MAX_BACKOFF)
    else:
        b = PROBE_MIN_BACKOFF
    st.setdefault("probe", {})[host.name] = {"backoff": b, "next_ts": time.time() + b}
    save_state(st)


def maybe_spawn_repath_probe(host):
    """After a successful call on a non-cheapest path, fire a detached probe
    that re-latches the cheapest path once it has recovered. Never blocks the
    call; rate-limited via state.json (exponential backoff on probe failures)."""
    if host.local or len(host.paths) < 2 or os.environ.get("BASHD_NOPROBE"):
        return
    st = load_state()
    si = (st.get("path") or {}).get(host.name)
    if si is None or si == cheapest_path_idx(host):
        return
    pr = (st.get("probe") or {}).get(host.name) or {}
    if time.time() < pr.get("next_ts", 0):
        return
    pr["next_ts"] = time.time() + PROBE_MIN_BACKOFF  # dedupe gate; child re-arms
    st.setdefault("probe", {})[host.name] = pr
    save_state(st)
    env = dict(os.environ, BASHD_HOME=HOME_DIR, BASHD_NOPROBE="1")
    try:
        subprocess.Popen([sys.executable, os.path.abspath(__file__),
                          "_repath-probe", host.name],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, env=env)
    except OSError:
        pass


def _try_path(host, idx):
    """Single-path connectivity probe: true iff the path runs a trivial script."""
    argv = _ssh_argv_for_path(host, host.paths[idx]) + ["sh", "-s"]
    t = host.connect["timeout_s"] * 2 + 5
    try:
        p = subprocess.run(argv, input=b"echo BASHD_PATH_OK", stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE, timeout=t)
    except subprocess.TimeoutExpired:
        return False, "timeout after %ss" % t
    if p.returncode == 0 and b"BASHD_PATH_OK" in p.stdout:
        return True, ""
    err = p.stderr.decode("utf-8", "replace").strip()
    return False, (err.splitlines()[-1] if err else "rc=%s" % p.returncode)[:200]


def repath_probe(host):
    """Probe paths cheaper than the current sticky one (cheapest first) and
    re-latch the first that connects. Used by the background probe and by
    `bashd paths --repath` / bash_hosts repath=true."""
    if host.local:
        return {"host": host.name, "action": "local"}
    if len(host.paths) < 2:
        return {"host": host.name, "action": "noop"}
    si = load_state().get("path", {}).get(host.name)
    if si is not None and si == cheapest_path_idx(host):
        return {"host": host.name, "action": "no_change", "sticky": si,
                "reason": "already on cheapest path"}
    order = sorted(range(len(host.paths)),
                   key=lambda i: (host.paths[i].get("cost", i), i))
    for idx in order:
        if idx == si:
            break  # reached the sticky path without finding anything cheaper
        ok, err = _try_path(host, idx)
        if ok:
            note_sticky_path(host, idx)
            _arm_probe(host, failed=False)
            return {"host": host.name, "action": "relatched", "path": idx, "from": si}
    _arm_probe(host, failed=True)
    return {"host": host.name, "action": "no_change", "sticky": si}


# ---------------------------------------------------------------- transport

_UNREACHABLE_PAT = re.compile(
    r"connection (refused|timed out|reset)|no route to host|network is unreachable"
    r"|name or service not known|temporary failure in name resolution|host unreachable",
    re.I)


def _ssh_opts(host):
    c = host.connect
    argv = ["ssh", "-o", "BatchMode=yes",
            "-o", "ConnectTimeout=%s" % c["timeout_s"],
            "-o", "ServerAliveInterval=%s" % c["keepalive_s"],
            "-o", "ServerAliveCountMax=%s" % c["keepalive_max"],
            "-o", "StrictHostKeyChecking=%s" % c["strict_host_keys"]]
    if c["control_master"]:
        argv += ["-o", "ControlMaster=auto",
                 "-o", "ControlPath=" + os.path.join(HOME_DIR, "cm-%C"),
                 "-o", "ControlPersist=600"]
    return argv


def _ssh_base_argv(host, path_args):
    return _ssh_opts(host) + path_args + [host.ssh]


def _ssh_argv_for_path(host, path):
    """Full argv up to (not including) the remote command, for a normalized path.
    exec_script appends the remote command (`sh -s`) uniformly."""
    if path["type"] == "hop":
        # The inner ssh runs on the hop host: give it its own ControlMaster
        # (relative ControlPath -> socket in the hop shell's cwd, i.e. ~hopper)
        # and keepalives, or every call re-pays the inner handshake — brutal on
        # slow relay paths. Generic opts first so hop_args can override.
        c = host.connect
        inner = ["ssh", "-o", "BatchMode=yes",
                 "-o", "StrictHostKeyChecking=accept-new",
                 "-o", "ServerAliveInterval=%s" % c["keepalive_s"],
                 "-o", "ServerAliveCountMax=%s" % c["keepalive_max"]]
        if c["control_master"]:
            inner += ["-o", "ControlMaster=auto",
                      "-o", "ControlPath=.bashd-cm-%C",
                      "-o", "ControlPersist=600"]
        inner += path["hop_args"]
        inner.append(path["target"])
        return _ssh_opts(host) + [path["hop"]] + inner
    return _ssh_opts(host) + path["args"] + [host.ssh]


def _path_order(host):
    """Path attempt order: sticky first, then cheapest-first. exec_script and
    the wire transport (v0.4) both iterate this."""
    si = sticky_path_idx(host)
    order = []
    if si is not None and 0 <= si < len(host.paths):
        order.append(si)
    order += sorted((i for i in range(len(host.paths)) if i not in order),
                    key=lambda i: (host.paths[i].get("cost", i), i))
    return order


def exec_script(host, script, timeout_s):
    """Run a POSIX sh script on the target. Returns (rc, stdout, stderr).
    Paths are tried sticky-first then cheapest-first; a mid-execution transport
    death retries the whole script on the next path (safe: every script run
    here is idempotent by substrate design — user commands live target-side in
    tmux + files, never inside the ssh call). Failures carry the per-path
    attempt trail. Raises Unreachable if no path connects. 'local' runs locally."""
    if host.local:
        try:
            p = subprocess.run(["/bin/sh", "-s"], input=script.encode(),
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               timeout=timeout_s)
        except subprocess.TimeoutExpired:
            raise BashdError("local exec timed out after %ss" % timeout_s)
        return p.returncode, p.stdout.decode("utf-8", "replace"), p.stderr.decode("utf-8", "replace")

    order = _path_order(host)
    last_err, last_unreach, attempts = None, None, []
    for idx in order:
        argv = _ssh_argv_for_path(host, host.paths[idx]) + ["sh", "-s"]
        try:
            p = subprocess.run(argv, input=script.encode(), stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE,
                               timeout=max(timeout_s, host.connect["timeout_s"] * 2 + 5))
        except subprocess.TimeoutExpired:
            attempts.append("path%d:timeout" % idx)
            last_err = "path %d timed out" % idx
            continue
        out = p.stdout.decode("utf-8", "replace")
        err = p.stderr.decode("utf-8", "replace")
        if p.returncode == 0:
            note_sticky_path(host, idx)
            maybe_spawn_repath_probe(host)
            return 0, out, err
        if p.returncode == 255 and _UNREACHABLE_PAT.search(err):
            attempts.append("path%d:unreachable" % idx)
            last_unreach = "path %d: %s" % (idx, err.strip().splitlines()[-1] if err.strip() else "unreachable")
            continue
        # auth error, host key, remote sh failure (rc from remote sh propagates as
        # 255? no: remote rc comes through as-is for exec; 255 is ssh itself)
        if p.returncode == 255:
            attempts.append("path%d:ssh-error" % idx)
            last_err = "ssh error on path %d: %s" % (idx, err.strip()[-300:])
        else:
            note_sticky_path(host, idx)
            maybe_spawn_repath_probe(host)
            return p.returncode, out, err
    trail = " [attempts: %s]" % "; ".join(attempts) if attempts else ""
    if last_unreach:
        raise Unreachable("%s unreachable (%s)%s" % (host.name, last_unreach, trail))
    raise BashdError("%s: %s%s" % (host.name, last_err or "all paths failed", trail))


# ---------------------------------------------------------------- ids

def new_id(host_name=None):
    return "%s%s" % (format(int(time.time()), "x"), secrets.token_hex(3))


def parse_id(jid):
    parts = jid.split(":")
    if len(parts) == 2 and ID_RE.match(parts[0]) and ID_RE.match(parts[1]):
        return get_host(parts[0]), "job", parts[1]
    if len(parts) == 3 and parts[1] == "tty" and ID_RE.match(parts[0]) and ID_RE.match(parts[2]):
        return get_host(parts[0]), "tty", parts[2]
    raise NotFound("bad id %r (expected host:jobid or host:tty:name)" % jid)


# ---------------------------------------------------------------- shell script builders

ENVELOPE_FMT = ('printf \'{"out_size":%s,"err_size":%s,"code":"%s","alive":%s,'
                '"out":"%s","err":"%s"}\\n\' "$o" "$e" "$c" "$a" "$ob" "$eb"')

# A codeless job whose session is gone can never finish (target reboot, killed
# session) — the read stamps it 143 so it stops showing as "running" forever.
# The lock check leaves half-created dirs (crash mid-submit) untouched.
# v0.3.1 orphan rule: even with the session alive, a codeless job whose lock
# nobody holds, whose files are all older than ORPHAN_GRACE_S and whose session
# has no executing job (a held lock) is dead — its submit lines were lost
# (queued tty input can be discarded by the terminal / readline while the
# shell is busy). Pre-grace and held-lock cases are never touched.
JOB_READ_TMPL = r'''
umask 077
d="$HOME/.bashd/jobs/__ID__"
if [ ! -d "$d" ]; then echo "BASHD_ENOENT"; exit 0; fi
o=0; e=0; c="-"; a=1
[ -f "$d/out" ] && o=$(wc -c < "$d/out" | tr -d " ")
[ -f "$d/err" ] && e=$(wc -c < "$d/err" | tr -d " ")
[ -f "$d/code" ] && c=$(cat "$d/code")
sess_name=$(cat "$d/session" 2>/dev/null)
if [ -n "$sess_name" ] && ! tmux -L bashd has-session -t "$sess_name" 2>/dev/null; then a=0; fi
if [ "$c" = "-" ] && [ -f "$d/lock" ]; then
  if [ "$a" = 0 ] || [ -z "$sess_name" ]; then
    echo 143 > "$d/code"; c=143; a=0
  elif command -v flock >/dev/null 2>&1; then
    ref="/tmp/.bashd_ref.$$"
    touch -d "@$(( $(date +%s) - __GRACE__ ))" "$ref" 2>/dev/null || ref=""
    if [ -n "$ref" ] && [ "$d/lock" -ot "$ref" ] && [ ! "$d/out" -nt "$ref" ] \
       && [ ! "$d/err" -nt "$ref" ] && flock -n "$d/lock" true 2>/dev/null; then
      busy=0
      for jl in "$HOME"/.bashd/jobs/*/lock; do
        [ -f "$jl" ] || continue
        jd=$(dirname "$jl")
        [ "$(cat "$jd/session" 2>/dev/null)" = "$sess_name" ] || continue
        [ -f "$jd/code" ] && continue
        flock -n "$jl" true 2>/dev/null || { busy=1; break; }
      done
      if [ "$busy" = 0 ]; then echo 143 > "$d/code"; c=143; fi
    fi
    [ -n "$ref" ] && rm -f "$ref"
  fi
fi
ob=$(tail -c +$((__CO__ + 1)) "$d/out" 2>/dev/null | head -c __MAX__ | base64 | tr -d "\n")
eb=$(tail -c +$((__CE__ + 1)) "$d/err" 2>/dev/null | head -c __MAX__ | base64 | tr -d "\n")
''' + ENVELOPE_FMT + "\n"

# Creation of (or no-op check for) a persistent session on the target. The
# init line applies session-lifetime settings (ulimit, BASHD_SESSION var).
# Stale jobs of a freshly re-created session are marked 143 (terminated).
# Race-safe: only the creator that won new-session runs init/pipe-pane/stamp.
SESS_ENSURE = r'''
if command -v tmux >/dev/null 2>&1; then :; else echo "BASHD_RESULT no-tmux"; exit 0; fi
created=0
if ! tmux -L bashd has-session -t __SESS__ 2>/dev/null; then
  # 9>&-: if SUBMIT_GUARD holds the submit flock on fd 9, a server forked here
  # would inherit that locked fd and hold the lock for the server's lifetime,
  # blocking every later submit to this session (2026-10-02: one fleet host's
  # session was stuck this way for 41h).
  if 9>&- tmux -L bashd new-session -d -s __SESS__ -x 220 -y 50 2>/dev/null; then
    created=1
  elif ! tmux -L bashd has-session -t __SESS__ 2>/dev/null; then
    echo "BASHD_RESULT tmux-fail"; exit 0
  fi
fi
if [ "$created" = 1 ]; then
  mkdir -p "$HOME/.bashd/tmux"
  tmux -L bashd set-option -t __SESS__ history-limit 50000 >/dev/null 2>&1
  tmux -L bashd pipe-pane -o -t __SESS__ "cat >> $HOME/.bashd/tmux/__SESS__.log"
  tmux -L bashd send-keys -t __SESS__ -l -- __INIT__
  tmux -L bashd send-keys -t __SESS__ Enter
  sleep 0.3
  for j in "$HOME"/.bashd/jobs/*/session; do
    [ -f "$j" ] || continue
    if [ "$(cat "$j")" = "__SESS__" ] && [ ! -f "$(dirname "$j")/code" ]; then
      echo 143 > "$(dirname "$j")/code"
    fi
  done
fi
'''

# Ctrl-C pending junk at the prompt, but never while one of OUR jobs may
# still run in this session. v0.3.1: "may run" = its lock is held (executing)
# or younger than ORPHAN_GRACE_S (submit may still be typing it / it may sit
# queued behind a running job). Stuck pre-0.3.1 records (codeless, unheld,
# old) no longer block clearing forever.
SESS_BUSYCLEAR = r'''
busy=0
haveflock=0; command -v flock >/dev/null 2>&1 && haveflock=1
ref="/tmp/.bashd_bc_ref.$$"
[ "$haveflock" = 1 ] && { touch -d "@$(( $(date +%s) - __GRACE__ ))" "$ref" 2>/dev/null || ref=""; }
for j in "$HOME"/.bashd/jobs/*/session; do
  [ -f "$j" ] || continue
  jd=$(dirname "$j")
  [ "$(cat "$j")" = "__SESS__" ] || continue
  [ -f "$jd/code" ] && continue
  if [ "$haveflock" = 0 ] || [ ! -f "$jd/lock" ]; then busy=1; break; fi
  [ -n "$ref" ] && [ "$jd/lock" -nt "$ref" ] && { busy=1; break; }
  flock -n "$jd/lock" true 2>/dev/null || { busy=1; break; }
done
if [ "$busy" = 0 ]; then tmux -L bashd send-keys -t __SESS__ C-c; fi
[ -n "$ref" ] && rm -f "$ref"
'''

# v0.3.1: submits to one session serialize on a target-side lock — two clients
# typing into the same pty at once interleave and corrupt each other's lines.
# The guard wraps SESS_ENSURE too: a session creator sleeps 0.3s inside the
# ensure (init typing); without the guard another client submits into the
# fresh session during that window and the creator's stale-stamp loop then
# finalizes that in-flight job as 143. Under the guard, creation and the
# stamp are atomic w.r.t. every submitter. The job's lock file is created
# after acquiring the guard, so a submit that died waiting leaves nothing
# behind and a same-id retry heals cleanly.
SUBMIT_GUARD = r'''
HAVEFLOCK=0
if command -v flock >/dev/null 2>&1; then
  HAVEFLOCK=1
  exec 9>"$HOME/.bashd/.submit-__SESS__.lock"
  if ! flock -w 50 9; then echo "BASHD_RESULT submit-busy"; exit 0; fi
fi
'''

JOB_SUBMIT_TAIL = r'''
d="$HOME/.bashd/jobs/__ID__"
if [ -f "$d/code" ]; then echo "BASHD_RESULT done-exists"; exit 0; fi
mkdir -p "$d" || { echo "BASHD_RESULT error"; exit 0; }
if ( set -C; : > "$d/lock" ) 2>/dev/null; then
  echo "__SESS__" > "$d/session"
  : > "$d/out"; : > "$d/err"
__PAYLOAD__
  if [ "$HAVEFLOCK" = 1 ]; then
    tmux -L bashd send-keys -t __SESS__ -l -- __LINE_ATOMIC__
    tmux -L bashd send-keys -t __SESS__ Enter
  else
    tmux -L bashd send-keys -t __SESS__ -l -- __LINE_PLAIN__
    tmux -L bashd send-keys -t __SESS__ Enter
  fi
  echo "BASHD_RESULT started"
else
  echo "BASHD_RESULT exists"
fi
'''

# signal = Ctrl-C into the job's session. Interactive bash DISCARDS pending
# input on SIGINT (the code-capture line would be eaten), so after a short
# grace we write 128+2 ourselves if the shell hasn't.
JOB_SIGNAL_TMPL = r'''
d="$HOME/.bashd/jobs/__ID__"
if [ -f "$d/code" ]; then echo "BASHD_RESULT dead"; exit 0; fi
S=$(cat "$d/session" 2>/dev/null)
if [ -z "$S" ] || ! tmux -L bashd has-session -t $S 2>/dev/null; then
  echo "$((128 + __SIGNUM__))" > "$d/code"
  echo "BASHD_RESULT dead"; exit 0
fi
tmux -L bashd send-keys -t $S C-c
i=0
while [ $i -lt 10 ] && ! [ -f "$d/code" ]; do sleep 0.3; i=$((i+1)); done
[ -f "$d/code" ] || echo 130 > "$d/code"
echo "BASHD_RESULT ctrl-c"
'''

TTY_READ_TMPL = r'''
