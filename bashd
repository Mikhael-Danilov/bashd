def _submit_payload(jid, cmd, cwd, env):
    """sh-script section that materializes the job's files DIRECTLY on the
    target (the submit script itself arrives over ssh/stdio — the tty is
    never used for payload bytes). v0.3.1: payloads used to be typed into the
    session as heredocs; queued tty input can be flushed/discarded (canonical
    buffer overflow, SIGINT input flush), destroying jobs mid-submit. Now the
    only typed bytes are ONE constant-size line (~230 chars)."""
    J = "$HOME/.bashd/jobs/" + jid
    pre = []
    if env:
        pre.append("export " + " ".join("%s=%s" % (k, shq(v)) for k, v in sorted(env.items())))
    if cwd:
        pre.append("cd %s || { echo 97 >\"$D/code\"; }" % shq(cwd))
    if not pre:
        pre = [":"]
    d1, d2 = "BASHD_P_" + secrets.token_hex(4), "BASHD_R_" + secrets.token_hex(4)
    b64pre = base64.b64encode(("\n".join(pre) + "\n").encode()).decode()
    b64run = base64.b64encode(cmd.encode()).decode()

    def heredoc(d, b, name):
        return "base64 -d >\"%s/%s\" <<'%s'\n%s\n%s" % (
            J, name, d, "\n".join(b[i:i + 76] for i in range(0, len(b), 76)), d)
    return heredoc(d1, b64pre, "pre") + "\n" + heredoc(d2, b64run, "run")


def _submit_line(jid, executor="atomic"):
    """The single line typed into the persistent session shell. The eval AND
    its exit-code capture are one line (a separate capture line queued behind
    the command can be discarded by the tty — the v0.2.x stuck-'running'
    bug), and it sources $D/pre first so cd/exports run in the session shell
    (they persist — the point of sessions). The atomic executor holds the
    job's lock for the run (fd 8): reads, the fleet overview and prune use it
    as the executing/orphan liveness marker; re-opening fd 8 in the next job
    releases any lock a Ctrl-C'd job left held. If a Ctrl-C aborts the eval,
    interactive bash skips the rest of the line and signal's 3s fallback
    writes 130 — the v0.2 contract."""
    D = '"$HOME/.bashd/jobs/%s"' % jid
    body = '. "$D/pre" 2>/dev/null; eval "$(cat "$D/run")" >"$D/out" 2>"$D/err"; ' \
           'rc=$?; [ -f "$D/code" ] || echo "$rc" >"$D/code"'
    if executor == "atomic":
        body = 'exec 8>>"$D/lock"; flock 8 2>/dev/null; %s; exec 8>&-' % body
    return 'D=%s; [ -f "$D/code" ] || { %s; }' % (D, body)


def _check_sess_name(s):
    if not ID_RE.match(s or ""):
        raise BashdError("bad session name %r (allowed: [A-Za-z0-9_-])" % s)
    return s


def job_start(host, jid, cmd, cwd=None, env=None, ulimit_mb=None, session="main", dry_run=False):
    _check_sess_name(session)
    if ulimit_mb is None:
        ulimit_mb = host.defaults.get("ulimit_mb", DEFAULT_ULIMIT_MB)
    init = "ulimit -f %d 2>/dev/null; export BASHD_SESSION=%s" % (int(ulimit_mb) * 1024, shq(session))
    # order matters: the submit guard covers session creation (a creator that
    # sleeps mid-ensure while another client submits into the fresh session
    # would stamp that in-flight job as dead), the busy-clear decision, and
    # the typing — all atomic w.r.t. every other submitter into this session
    guard = (SUBMIT_GUARD.replace("__SESS__", session))
    ensure = SESS_ENSURE.replace("__SESS__", session).replace("__INIT__", shq(init))
    clear = SESS_BUSYCLEAR.replace("__SESS__", session).replace("__GRACE__", str(ORPHAN_GRACE_S))
    script = guard + ensure + clear
    script += (JOB_SUBMIT_TAIL.replace("__SESS__", session).replace("__ID__", jid)
               .replace("__PAYLOAD__", _submit_payload(jid, cmd, cwd, env))
               .replace("__LINE_ATOMIC__", shq(_submit_line(jid, "atomic")))
               .replace("__LINE_PLAIN__", shq(_submit_line(jid, "plain"))))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=60)[1]
    m = re.search(r"BASHD_RESULT (\S+)", out)
    state = m.group(1) if m else "unknown"
    if state == "no-tmux":
        raise BashdError("tmux is not installed on host %r (required in v0.2: all modes "
                         "run inside persistent tmux sessions)" % host.name)
    if state in ("error", "tmux-fail"):
        raise BashdError("job start failed on %s (session %s)" % (host.name, session))
    if state == "submit-busy":
        raise BashdError("submit lock busy on %s (session %s held >50s by another submit; "
                         "retry)" % (host.name, session))
    return state


def _b64d(s):
    if not s:
        return b""
    return base64.b64decode(s)


def _code_to_int(c):
    if c is None or c in ("-", ""):
        return None
    try:
        return int(c)
    except ValueError:
        return None


# ---------------------------------------------------------------- job substrate ops


def exec_argv_preview(host, script):
    if host.local:
        return {"argv": ["/bin/sh", "-s"], "stdin": script}
    return {"argv": _ssh_argv_for_path(host, host.paths[0]), "stdin": script}


def job_read(host, jid, cursor_out=0, cursor_err=0, max_bytes=DEFAULT_MAX_BYTES, dry_run=False):
    script = (JOB_READ_TMPL.replace("__ID__", jid)
              .replace("__CO__", str(int(cursor_out)))
              .replace("__CE__", str(int(cursor_err)))
              .replace("__MAX__", str(int(max_bytes)))
              .replace("__GRACE__", str(ORPHAN_GRACE_S)))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=60)[1].strip()
    if "BASHD_ENOENT" in out.splitlines()[-1] if out else False:
        raise NotFound("no such job %r on %s" % (jid, host.name))
    try:
        line = out.splitlines()[-1] if out else ""
        env = json.loads(line)
    except (ValueError, IndexError):
        raise BashdError("job read: bad envelope from %s: %r" % (host.name, out[-200:]))
    ob, eb = _b64d(env["out"]), _b64d(env["err"])
    return {"status": "done" if env["code"] not in ("-", "") else "running",
            "exit_code": _code_to_int(env["code"]),
            "alive": bool(int(env.get("alive", 1))),
            "stdout": ob.decode("utf-8", "replace"),
            "stderr": eb.decode("utf-8", "replace"),
            "cursor_out": cursor_out + len(ob),
            "cursor_err": cursor_err + len(eb),
            "out_size": int(env["out_size"]), "err_size": int(env["err_size"])}


def job_signal(host, jid, sig="TERM", dry_run=False):
    signum = _signal.Signals["SIG" + sig].value if isinstance(sig, str) else int(sig)
    script = (JOB_SIGNAL_TMPL.replace("__ID__", jid).replace("__SIGNUM__", str(signum)))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=30)[1]
    m = re.search(r"BASHD_RESULT (\S+)", out)
    return {"action": m.group(1) if m else "unknown"}


# ---------------------------------------------------------------- tty substrate ops

def session_ensure(host, name, ulimit_mb=None, dry_run=False):
    """Create the persistent session if missing (init line: ulimit + marker var)."""
    _check_sess_name(name)
    if ulimit_mb is None:
        ulimit_mb = host.defaults.get("ulimit_mb", DEFAULT_ULIMIT_MB)
    init = "ulimit -f %d 2>/dev/null; export BASHD_SESSION=%s" % (int(ulimit_mb) * 1024, shq(name))
    script = SESS_ENSURE.replace("__SESS__", name).replace("__INIT__", shq(init))
    script += 'echo "BASHD_RESULT ok"\n'
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=60)[1]
    m = re.search(r"BASHD_RESULT (\S+)", out)
    state = m.group(1) if m else "unknown"
    if state == "no-tmux":
        raise BashdError("tmux is not installed on host %r (required in v0.2: all modes "
                         "run inside persistent tmux sessions)" % host.name)
    if state == "tmux-fail":
        raise BashdError("session create failed on %s (%s)" % (host.name, name))
    return state


def tty_read(host, name, cursor=0, max_bytes=DEFAULT_MAX_BYTES, screen=False, dry_run=False):
    script = (TTY_READ_TMPL.replace("__NAME__", name)
              .replace("__CO__", str(int(cursor)))
              .replace("__MAX__", str(int(max_bytes)))
              .replace("__SCREEN__", "1" if screen else "0"))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=60)[1].strip()
    try:
        env = json.loads(out.splitlines()[-1] if out else "{}")
    except ValueError:
        raise BashdError("tty read: bad envelope from %s: %r" % (host.name, out[-200:]))
    ob = _b64d(env.get("out", ""))
    chunk = ob.decode("utf-8", "replace")
    # stdout_b: the raw bytes (term streams terminal control sequences that
    # must not be round-tripped through a lossy text decode)
    return {"alive": bool(env.get("alive")),
            "stdout": chunk, "stdout_b": ob, "cursor": cursor + len(ob),
            "size": int(env.get("size", 0)),
            "screen": _b64d(env.get("screen", "")).decode("utf-8", "replace")}


def tty_write(host, name, data, append_newline=True, dry_run=False):
    # append_newline=False must send EXACTLY the bytes (term's live mode types
    # raw keystrokes; a forced Enter would execute half-typed lines). v0.3.x
    # had the Enter send unconditionally — a latent bash_write bug.
    enter = ("tmux -L bashd send-keys -t __NAME__ Enter >/dev/null 2>&1"
             if append_newline is not False else ":")
    script = (TTY_WRITE_TMPL.replace("__ENTER__", enter)   # enter carries __NAME__
              .replace("__NAME__", name)
              .replace("__DATA__", shq(data)))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=30)[1]
    return {"written": len(data),
            "ok": "BASHD_RESULT ok" in out}


def tty_signal(host, name, mode, dry_run=False):
    script = (TTY_SIGNAL_TMPL.replace("__NAME__", name).replace("__MODE__", mode))
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=30)[1]
    m = re.search(r"BASHD_RESULT (\S+)", out)
    return {"action": m.group(1) if m else "unknown"}


# ---------------------------------------------------------------- wire transport (v0.4)

# A custom transport for extremely slow / unstable links: ONE long-lived ssh
# channel per attach, running a tiny frame agent on the target, instead of one
# `ssh … sh -s` exec per operation (no per-op handshakes, gzip payloads,
# server-pushed output deltas so echo latency ~= one RTT). Frames are single
# text lines:
#   C->A: PING | W <seq> <sess> <payload> | R <rid> <sess> <cursor> <max>
#         | S <sess> int|kill | Z <sess> <cols> <rows> | SUB <sess> <cursor>
#         | UNSUB <sess> | Q
#   A->C: HELO <ver> <flavor> <push> | PONG <ms> | ACK <seq>
#         | DATA <rid> <sess> <newcursor> <payload>   (rid 0 = push)
#         | ST <rid> <sess> <size> <alive> | GONE <sess> | OK/ERR <what>
# <payload> = "g"+b64(gzip(bytes)) or "b"+b64(bytes), whichever is smaller.
# The bash flavor pushes at WIRE_TICK; a POSIX-sh flavor (no `read -t`, no
# bash) answers PING/W/R/S/Z only — the client polls it. On channel death the
# client re-spawns over the next path and resumes from delivered cursors;
# sent-but-unacked input is REPORTED and dropped, never replayed (a replayed
# Enter could execute a line twice).

WIRE_PUSH_MAX = 12288        # raw bytes per push/read frame
WIRE_SPLIT = 3000            # raw bytes per W frame (client splits big writes)
WIRE_GZ_MIN = 300            # gzip payloads from this size (23 B container overhead)
WIRE_TICK = 0.1              # agent push loop period (bash flavor)
WIRE_PING_EVERY = 5.0
WIRE_QUEUE_MAX = 65536       # typed-ahead input buffered locally while link is down

WIRE_AGENT_BASH = r'''umask 077
[ -n "$BASH_VERSION" ] || exit 9   # dash would busy-spin on `read -t`; fall to the sh agent
set -f
T="${TMPDIR:-/tmp}/.bashd_wire_$$"
trap 'rm -f "$T" 2>/dev/null; exit 0' INT TERM EXIT
CURS=""; SUBS=""
cur_of() { for kc in $CURS; do case "$kc" in "$1":*) echo "${kc#*:}"; return;; esac; done; echo 0; }
set_cur() { o=""; for kc in $CURS; do case "$kc" in "$1":*) continue;; esac; o="$o $kc"; done; CURS="$o $1:$2"; }
log_of() { echo "$HOME/.bashd/tmux/$1.log"; }
alive() { tmux -L bashd has-session -t "$1" 2>/dev/null; }
FB_N=0
frame_out() {  # $1 log, $2 start cursor, $3 max -> "<N> <payload>" on stdout
  : > "$T" 2>/dev/null
  tail -c +$(( $2 + 1 )) "$1" 2>/dev/null | head -c "$3" > "$T" 2>/dev/null
  FB_N=$(wc -c < "$T" | tr -d " \n"); [ -n "$FB_N" ] || FB_N=0
  if [ "$FB_N" -ge 300 ]; then printf '%s g' "$FB_N"; gzip -c "$T" 2>/dev/null | base64 | tr -d "\n"
  else printf '%s b' "$FB_N"; base64 < "$T" 2>/dev/null | tr -d "\n"; fi
}
push_all() {
  [ -n "$SUBS" ] || return 0
  for s in $SUBS; do
    alive "$s" || { echo "GONE $s"; SUBS=$(printf "%s\n" $SUBS | grep -vx "$s" | tr "\n" " "); continue; }
    lg=$(log_of "$s"); [ -f "$lg" ] || continue
    sz=$(wc -c < "$lg" 2>/dev/null | tr -d " \n"); [ -n "$sz" ] || sz=0
    c=$(cur_of "$s")
    if [ "$sz" -gt "$c" ]; then
      fr=$(frame_out "$lg" "$c" __PUSH_MAX__); FB_N=${fr%% *}; p=${fr#* }
      set_cur "$s" "$(( c + FB_N ))"
      echo "DATA 0 $s $(( c + FB_N )) $p"
    fi
  done
}
do_cmd() {
  case "$1" in
    PING) echo "PONG $(date +%s%3N 2>/dev/null || date +%s)" ;;
    W)
      case "$4" in
        g*) d=$(printf "%s" "${4#g}" | base64 -d 2>/dev/null | gzip -dc 2>/dev/null; printf x) ;;
        *) d=$(printf "%s" "${4#b}" | base64 -d 2>/dev/null; printf x) ;;
      esac
      d=${d%x}
      if alive "$3"; then
        tmux -L bashd send-keys -t "$3" -l -- "$d" 2>/dev/null && echo "ACK $2" || echo "ERR W"
      else
        echo "GONE $3"
      fi ;;
    R)
      if ! alive "$3"; then echo "GONE $3"; echo "ST $2 $3 0 0"; return; fi
      lg=$(log_of "$3"); [ -f "$lg" ] || lg=/dev/null
      fr=$(frame_out "$lg" "$4" "$5"); FB_N=${fr%% *}; p=${fr#* }
      set_cur "$3" "$(( $4 + FB_N ))"
      sz=$(wc -c < "$lg" 2>/dev/null | tr -d " \n"); [ -n "$sz" ] || sz=0
      echo "DATA $2 $3 $(( $4 + FB_N )) $p"
      echo "ST $2 $3 $sz 1" ;;
    S)
      if ! alive "$2"; then echo "GONE $2"; return; fi
      if [ "$3" = kill ]; then tmux -L bashd kill-session -t "$2" 2>/dev/null && echo "OK S killed" || echo "ERR S"
      else tmux -L bashd send-keys -t "$2" C-c 2>/dev/null && echo "OK S int" || echo "ERR S"; fi ;;
    Z)
      tmux -L bashd set-option -w -t "$2" window-size manual >/dev/null 2>&1
      tmux -L bashd resize-window -t "$2" -x "$3" -y "$4" >/dev/null 2>&1 && echo "OK Z" || echo "ERR Z" ;;
    SUB)
      case " $SUBS " in *" $2 "*) : ;; *) SUBS="$SUBS $2" ;; esac
      set_cur "$2" "${3:-0}"; echo "OK SUB $2" ;;
    UNSUB)
      SUBS=$(printf "%s\n" $SUBS | grep -vx "$2" | tr "\n" " "); echo "OK UNSUB $2" ;;
    Q) echo "BYE"; exit 0 ;;
    *) echo "ERR frame $1" ;;
  esac
}
echo "HELO 1 bash push"
pend=""
while :; do
  if IFS= read -r -t __TICK__ seg; then
    line="$pend$seg"; pend=""
    set -- $line
    [ -n "$1" ] && do_cmd "$@"
  else
    pend="$pend$seg"      # partial line: TCP may split long frames
    [ "${#pend}" -gt 131072 ] && pend=""
  fi
  push_all
done
'''

WIRE_AGENT_SH = r'''umask 077
