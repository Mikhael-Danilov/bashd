      echo "DATA $2 $3 $(( $4 + FB_N )) $p"
      echo "ST $2 $3 $sz 1" ;;
    S)
      if ! alive "$2"; then echo "GONE $2"; return; fi
      if [ "$3" = kill ]; then tmux -L bashd kill-session -t "$2" 2>/dev/null && echo "OK S killed" || echo "ERR S"
      else tmux -L bashd send-keys -t "$2" C-c 2>/dev/null && echo "OK S int" || echo "ERR S"; fi ;;
    Z)
      tmux -L bashd set-option -w -t "$2" window-size manual >/dev/null 2>&1
      tmux -L bashd resize-window -t "$2" -x "$3" -y "$4" >/dev/null 2>&1 && echo "OK Z" || echo "ERR Z" ;;
    Q) echo "BYE"; exit 0 ;;
    *) echo "ERR frame $1" ;;
  esac
}
echo "HELO 1 sh poll"
while IFS= read -r line; do
  set -- $line
  [ -n "$1" ] && do_cmd "$@"
done
'''


def wire_enc(raw):
    if len(raw) >= WIRE_GZ_MIN:
        try:
            gz = "g" + base64.b64encode(gzip.compress(raw)).decode("ascii")
            if len(gz) < len(raw) * 4 // 3 + 2:
                return gz
        except Exception:
            pass
    return "b" + base64.b64encode(raw).decode("ascii")


def wire_dec(pl):
    try:
        if pl[:1] == "g":
            return gzip.decompress(base64.b64decode(pl[1:]))
        return base64.b64decode(pl[1:])
    except Exception:
        return b""


def _wire_argv(host, path, interpreter):
    if host.local:
        return [interpreter, "-s"]
    # -C: zlib the whole channel — frame payloads are base64 text, our own
    # gzip handles the big deltas and ssh -C squeezes the rest
    argv = _ssh_argv_for_path(host, path)
    return argv[:1] + ["-C"] + argv[1:] + [interpreter, "-s"]


class WireChannel:
    """One long-lived frame channel to a target. Thread-safe; reconnects are
    internal (monitor thread re-spawns over _path_order, resubscribes every
    session at its last delivered cursor, then flushes typed-ahead input that
    was queued while down). Sent-but-unacked input frames are dropped with an
    input-dropped event — never replayed."""

    def __init__(self, host, on_event=None):
        self.host = host
        self.on_event = on_event or (lambda kind, info: None)
        self.proc = None
        self.flavor = None
        self.push = False
        self.ver = 0
        self.wlock = threading.Lock()
        self.rlock = threading.Lock()
        self._rid = itertools.count(1)
        self._seq = 0
        self._rpend = {}          # rid -> {"ev": Event, "frames": [(kind, ...)]}
        self._unacked = {}        # seq -> bytes sent, not yet ACKed
        self.subs = {}            # sess -> callback(bytes | None)
        self.cursors = {}         # sess -> last delivered cursor
        self.rtt = None
        self.dead = True
        self.closed = False
        self.drops = 0
        self._inq = collections.deque()
        self._inq_bytes = 0
        self._cond = threading.Condition()
        self._pong_evt = threading.Event()
        self._pong_t0 = 0.0

    def _flavors(self):
        if self.host.local:
            out = []
            b = shutil.which("bash")
            if b:
                out.append((b, WIRE_AGENT_BASH))
            out.append((shutil.which("sh") or "/bin/sh", WIRE_AGENT_SH))
            return out
        return [("bash", WIRE_AGENT_BASH), ("sh", WIRE_AGENT_SH)]

    def _spawn(self, idx, interpreter, script):
        argv = _wire_argv(self.host, self.host.paths[idx], interpreter)
        try:
            p = subprocess.Popen(argv, stdin=subprocess.PIPE,
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError as e:
            raise BashdError("wire spawn failed: %s" % e)
        try:
            p.stdin.write(script.replace("__PUSH_MAX__", str(WIRE_PUSH_MAX))
                          .replace("__TICK__", str(WIRE_TICK)).encode())
            p.stdin.flush()
        except OSError:
            pass  # agent died instantly (rc 9/127) — poll() below notices
        deadline = time.time() + self.host.connect["timeout_s"] * 2 + 5
        line = b""
        while time.time() < deadline:
            if p.poll() is not None:
                try:
                    p.stdin.close()
                except OSError:
                    pass
                raise BashdError("wire agent exited rc=%s" % p.returncode)
            r, _, _ = select.select([p.stdout], [], [], 0.2)
            if r:
                line = p.stdout.readline()
                if line:
                    break
        if not line:
            p.kill()
            raise BashdError("wire HELO timeout")
        parts = line.decode("utf-8", "replace").split()
        if len(parts) < 4 or parts[0] != "HELO":
            p.kill()
            raise BashdError("wire bad HELO: %r" % line[:100])
        self.proc = p
        self.ver = int(parts[1])
        self.flavor = parts[2]
        self.push = parts[3] == "push"
        return {"ver": self.ver, "flavor": self.flavor, "push": self.push, "path": idx}

    def connect(self):
        attempts = []
        for idx in _path_order(self.host):
            for interpreter, script in self._flavors():
                try:
                    info = self._spawn(idx, interpreter, script)
                except BashdError as e:
                    attempts.append("path%d/%s:%s" % (idx, interpreter, e))
                    continue
                if not self.host.local:
                    note_sticky_path(self.host, idx)
                self.dead = False
                self._start_reader()
                threading.Thread(target=self._monitor, daemon=True,
                                 name="bashd-wire-monitor").start()
                threading.Thread(target=self._pinger, daemon=True,
                                 name="bashd-wire-pinger").start()
                return info
        trail = "; ".join(attempts[:6])
        raise Unreachable("%s wire: no path connected (%s)" % (self.host.name, trail))

    def _start_reader(self):
        threading.Thread(target=self._reader, daemon=True,
                         name="bashd-wire-reader").start()
    # ---- plumbing -------------------------------------------------------

    def _send(self, line):  # caller holds wlock
        if self.dead or self.closed or not self.proc:
            raise BashdError("wire channel down")
        try:
            self.proc.stdin.write((line + "\n").encode())
            self.proc.stdin.flush()
        except OSError as e:
            self._die("send failed: %s" % e)
            raise BashdError("wire send failed")

    def _reader(self):
        me = self.proc
        for raw in iter(me.stdout.readline, b""):
            if self.proc is not me or self.closed:
                break
            self._dispatch(raw.decode("utf-8", "replace").rstrip("\n"))
        if self.proc is me and not self.closed:
            self._die("agent closed the channel")

    def _dispatch(self, line):
        t = line.split(" ")
        op = t[0]
        if op == "DATA":
            rid, sess, cur = int(t[1]), t[2], int(t[3])
            data = wire_dec(t[4]) if len(t) > 4 else b""
            if rid:
                with self.rlock:
                    if rid in self._rpend:
                        self._rpend[rid]["frames"].append(("data", cur, data))
            elif sess in self.subs:
                self.cursors[sess] = cur
                try:
                    self.subs[sess](data)
                except Exception:
                    pass
        elif op == "ST":
            rid = int(t[1])
            with self.rlock:
                pend = self._rpend.get(rid)
                if pend:
                    pend["frames"].append(("st", int(t[3]), int(t[4])))
                    pend["ev"].set()
        elif op == "ACK":
            self._unacked.pop(int(t[1]), None)
        elif op == "PONG":
            r = time.time() - self._pong_t0
            self.rtt = r if self.rtt is None else self.rtt * 0.7 + r * 0.3
            self._pong_evt.set()
        elif op == "GONE":
            sess = t[1] if len(t) > 1 else ""
            if sess in self.subs:
                try:
                    self.subs[sess](None)
                except Exception:
                    pass
        elif op == "ERR":
            self.on_event("agent-msg", line)
        elif op == "BYE":
            return  # reader EOF path cleans up

    def _die(self, reason):
        with self._cond:
            if self.dead or self.closed:
                return
            self.dead = True
            self.drops += 1
            try:
                self.proc.kill()
            except Exception:
                pass
            in_flight = sum(self._unacked.values())
            self._unacked.clear()
            with self.rlock:
                for v in self._rpend.values():
                    v["ev"].set()
            self._pong_evt.set()
            self._cond.notify_all()
        if in_flight:
            self.on_event("input-dropped", in_flight)
        self.on_event("dead", reason)

    def _monitor(self):
        backoff = 1.0
        while not self.closed:
            with self._cond:
                while not self.dead and not self.closed:
                    self._cond.wait(1.0)
                if self.closed:
                    return
            ok = False
            for idx in _path_order(self.host):
                for interpreter, script in self._flavors():
                    try:
                        self._spawn(idx, interpreter, script)
                    except BashdError:
                        continue
                    if not self.host.local:
                        note_sticky_path(self.host, idx)
                    self.dead = False
                    self._start_reader()
                    with self.wlock:
                        try:
                            for s in list(self.subs):
                                self._send("SUB %s %d" % (s, self.cursors.get(s, 0)))
                        except BashdError:
                            self.dead = True  # died again mid-resub; keep retrying
                            continue
                    self._flush_input()
                    self.on_event("reconnected", {"path": idx, "flavor": self.flavor})
                    ok = True
                    break
                if ok:
                    break
            if not ok:
                time.sleep(backoff)
                backoff = min(backoff * 2, 10.0)
            else:
                backoff = 1.0

    def _pinger(self):
        misses = 0
        while not self.closed:
            time.sleep(WIRE_PING_EVERY)
            if self.closed or self.dead:
                continue
            if self.ping() is None:
                misses += 1
                if misses >= 2:
                    self._die("ping timeout (link blackholed?)")
                    return
            else:
                misses = 0

    # ---- public ops -----------------------------------------------------

    def read(self, sess, cursor, max_bytes=WIRE_PUSH_MAX):
        rid = next(self._rid)
        ev = threading.Event()
        with self.rlock:
            self._rpend[rid] = {"ev": ev, "frames": []}
        try:
            with self.wlock:
                self._send("R %d %s %d %d" % (rid, sess, cursor, max_bytes))
            if not ev.wait(max(30.0, (self.rtt or 0) * 8)):
                raise BashdError("wire read timeout")
        finally:
            with self.rlock:
                pend = self._rpend.pop(rid, {"frames": []})
        data = b""
        cur, size, alive = cursor, 0, 1
        for kind, a, b in pend["frames"]:
            if kind == "data":
                cur, data = a, b
            else:
                size, alive = a, b
        return {"cursor": cur, "data": data, "size": size, "alive": bool(alive)}

    def _queue_input(self, sess, data):
        if self._inq_bytes + len(data) > WIRE_QUEUE_MAX:
            self.on_event("input-dropped", len(data))
            return
        self._inq.append((sess, data))
        self._inq_bytes += len(data)

    def _flush_input(self):  # monitor thread, after reconnect
        with self.wlock:
            while self._inq:
                sess, data = self._inq.popleft()
                self._inq_bytes -= len(data)
                for i in range(0, len(data), WIRE_SPLIT):
                    chunk = data[i:i + WIRE_SPLIT]
                    self._seq += 1
                    self._unacked[self._seq] = len(chunk)
                    try:
                        self._send("W %d %s %s" % (self._seq, sess, wire_enc(chunk)))
                    except BashdError:
                        self._unacked.pop(self._seq, None)
                        self._inq.appendleft((sess, data[i:]))
                        self._inq_bytes += len(data) - i
                        return

    def write(self, sess, data):
        data = data.replace(b"\x00", b"")  # argv cannot carry NUL
        if not data:
            return {"sent": 0}
        if self.dead:
            self._queue_input(sess, data)
            return {"queued": self._inq_bytes}
        with self.wlock:
            for i in range(0, len(data), WIRE_SPLIT):
                chunk = data[i:i + WIRE_SPLIT]
                self._seq += 1
                self._unacked[self._seq] = len(chunk)
                try:
                    self._send("W %d %s %s" % (self._seq, sess, wire_enc(chunk)))
                except BashdError:
                    self._unacked.pop(self._seq, None)
                    self._queue_input(sess, data[i:])
                    return {"queued": self._inq_bytes}
            return {"sent": len(data), "seq": self._seq}

    def sub(self, sess, cursor, cb):
        self.subs[sess] = cb
        self.cursors[sess] = cursor
        if not self.dead:
            with self.wlock:
                try:
                    self._send("SUB %s %d" % (sess, cursor))
                except BashdError:
                    pass

    def unsub(self, sess):
        self.subs.pop(sess, None)
        if not self.dead:
            with self.wlock:
                try:
                    self._send("UNSUB %s" % sess)
                except BashdError:
                    pass

    def signal(self, sess, mode="int"):
        if not self.dead:
            with self.wlock:
                try:
                    self._send("S %s %s" % (sess, mode))
                except BashdError:
                    pass

    def resize(self, sess, cols, rows):
        if not self.dead:
            with self.wlock:
                try:
                    self._send("Z %s %d %d" % (sess, cols, rows))
                except BashdError:
                    pass

    def ping(self, timeout=None):
        self._pong_evt.clear()
        self._pong_t0 = time.time()
        try:
            with self.wlock:
                self._send("PING")
        except BashdError:
            return None
        if not self._pong_evt.wait(timeout or max(8.0, (self.rtt or 0) * 6)):
            return None
        return time.time() - self._pong_t0

    def close(self):
        self.closed = True
        with self._cond:
            self._cond.notify_all()
        if self.proc:
            try:
                self.proc.stdin.write(b"Q\n")
                self.proc.stdin.flush()
            except Exception:
                pass
            try:
                self.proc.wait(timeout=2)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass


# ---------------------------------------------------------------- high-level ops

def _tail_cap(s, cap):
    if len(s) <= cap:
        return s, 0
    dropped = len(s) - cap
    return s[dropped:], dropped


def do_run(host, cmd, timeout_s=120, max_bytes=DEFAULT_MAX_BYTES, cwd=None, env=None,
           jid=None, ulimit_mb=None, session="main", dry_run=False):
    if dry_run:
        return job_start(host, "previewid", cmd, cwd, env, ulimit_mb, session=session, dry_run=True)
    jid = jid or new_id()
    t0 = time.time()
    # Mid-command failover at entry: if every path is down right now, keep
    # retrying the submit for a short grace — it is idempotent by id, and the
    # substrate tolerates it landing late.
    grace = min(15.0, max(1.0, timeout_s))
    submit_retries = 0
    while True:
        try:
            state = job_start(host, jid, cmd, cwd, env, ulimit_mb, session=session)
            break
        except Unreachable:
            if time.time() - t0 >= grace:
                raise
            submit_retries += 1
            time.sleep(1.0)
    res = {"ok": True, "id": "%s:%s" % (host.name, jid), "host": host.name,
           "start_state": state, "status": "running", "exit_code": None,
           "stdout": "", "stderr": "", "cursor_out": 0, "cursor_err": 0,
           "duration_s": None, "timed_out": False, "note": host.notes}
    if submit_retries:
        res["submit_retries"] = submit_retries
    if state == "done-exists":
        r = job_read(host, jid, 0, 0, max_bytes * 4)
        res.update(status=r["status"], exit_code=r["exit_code"], stdout=r["stdout"],
                   stderr=r["stderr"], cursor_out=r["cursor_out"], cursor_err=r["cursor_err"])
        return res
    poll = POLL_LOCAL if host.local else POLL_REMOTE
    acc_o = acc_e = ""
    link_drops = 0
    while True:
        time.sleep(poll)
        try:
            r = job_read(host, jid, res["cursor_out"], res["cursor_err"], READ_CHUNK)
        except (Unreachable, BashdError) as e:
            link_drops += 1
            if time.time() - t0 >= timeout_s:
                res["dropped_link"] = str(e)
                res["link_drops"] = link_drops
                break
            time.sleep(min(1.0 * link_drops, 5.0))
            continue
        if link_drops:
            res["link_recovered"] = True
            res["link_drops"] = link_drops
            link_drops = 0
        res["cursor_out"], res["cursor_err"] = r["cursor_out"], r["cursor_err"]
        acc_o += r["stdout"]
        acc_e += r["stderr"]
        if len(acc_o) > ACC_CAP:
            acc_o = acc_o[-ACC_CAP:]
        if len(acc_e) > ACC_CAP:
            acc_e = acc_e[-ACC_CAP:]
        if r["status"] == "done":
            res["status"] = "done"
            res["exit_code"] = r["exit_code"]
            res["duration_s"] = round(time.time() - t0, 3)
            break
        if not r.get("alive", True):
            res["status"] = "dead"
            res["duration_s"] = round(time.time() - t0, 3)
            break
        if time.time() - t0 >= timeout_s:
            res["timed_out"] = True
            break
    acc_o, dropped_o = _tail_cap(acc_o, max_bytes * 8)
    acc_e, dropped_e = _tail_cap(acc_e, max_bytes * 8)
    res["stdout"], res["stderr"] = acc_o, acc_e
    if dropped_o:
        res["stdout_dropped_head_bytes"] = dropped_o
    if dropped_e:
        res["stderr_dropped_head_bytes"] = dropped_e
    return res


def do_wait(host, kind, key, timeout_s=120, until="exit", pattern=None, idle_s=2.0,
            max_bytes=DEFAULT_MAX_BYTES, until_reachable=False, dry_run=False):
    if dry_run:
        return {"dry_run": "wait is runtime-only"}
    rx = re.compile(pattern, re.MULTILINE) if pattern else None
    if rx is None and until == "regex":
        raise BashdError("until=regex requires --pattern")
    t0 = time.time()
    deadline = t0 + timeout_s
    if kind == "job":
        read = lambda co, ce: job_read(host, key, co, ce, READ_CHUNK)
    else:
        read = lambda co, ce: tty_read(host, key, co, READ_CHUNK)

    cur_o = cur_e = 0
    try:
        first = read(0, 0)
        if kind == "job":
            cur_o = max(0, first["out_size"] - KEEP_WINDOW)
            cur_e = max(0, first.get("err_size", 0) - KEEP_WINDOW)
        else:
            cur_o = max(0, first["size"] - KEEP_WINDOW)
        entry_unreachable = None
    except (Unreachable, BashdError) as e:
        if not until_reachable:
            raise
        first, entry_unreachable = None, str(e)

    acc = ""
    last_change = time.time()
    code = None
    alive = True
    match = None
    poll = POLL_LOCAL if host.local else POLL_REMOTE
    backoff = 1.0
    link_drops = 0
    status = "running"
    while True:
        if entry_unreachable is not None:
            try:
                first = read(0, 0)
                cur_o = max(0, first["out_size"] - KEEP_WINDOW)
                cur_e = max(0, first.get("err_size", 0) - KEEP_WINDOW)
                sizes = (first["out_size"], first.get("err_size", 0))
                entry_unreachable = None
            except (Unreachable, BashdError):
                if time.time() >= deadline:
                    raise Unreachable("still unreachable after %ss: %s" % (timeout_s, entry_unreachable))
                time.sleep(min(backoff, max(0.1, deadline - time.time())))
                backoff = min(backoff * 2, 5)
                continue
        time.sleep(poll)
        try:
            if kind == "job":
                r = read(cur_o, cur_e)
                new = r["stdout"] + r["stderr"]
                cur_o, cur_e = r["cursor_out"], r["cursor_err"]
                code = r["exit_code"]
                alive = r.get("alive", True)
            else:
                r = read(cur_o, 0)
                new = r["stdout"]
                cur_o = r["cursor"]
                alive = r["alive"]
            backoff = 1.0
        except (Unreachable, BashdError) as e:
            link_drops += 1
            if time.time() >= deadline:
                res = {"ok": True, "status": "running", "link_lost": True,
                       "link_error": str(e), "waited_s": round(time.time() - t0, 2)}
                if link_drops:
                    res["link_drops"] = link_drops
                return _wait_result(res, acc, max_bytes, match)
            time.sleep(min(backoff, max(0.1, deadline - time.time())))
            backoff = min(backoff * 2, 5)
            continue
        if new:
            acc += new
            if len(acc) > ACC_CAP:
                acc = acc[-ACC_CAP:]
            last_change = time.time()
        if rx is not None:
            m = rx.search(acc)
            if m:
                match = m.group(0)
                break
        if until == "exit" and (code is not None or not alive):
            break
        if until == "idle" and (time.time() - last_change) >= idle_s:
            break
        if time.time() >= deadline:
            break
    waited = round(time.time() - t0, 2)
    if code is not None:
        status = "done"
    elif not alive:
        status = "dead"
    else:
        status = "running"
    res = {"ok": True, "status": status, "exit_code": code, "waited_s": waited}
    if link_drops:
        res["link_drops"] = link_drops
        res["link_recovered"] = True
    return _wait_result(res, acc, max_bytes, match)


def _wait_result(res, acc, max_bytes, match):
    acc, dropped = _tail_cap(acc, max_bytes)
    if dropped:
        res["dropped_head_bytes"] = dropped
    res["stdout"] = acc
    if match:
        res["match"] = match
    return res


def do_start(host, cmd=None, mode="batch", name=None, cwd=None, env=None, jid=None,
             session=None, dry_run=False):
    if mode == "tty" and not cmd:
        sname = _check_sess_name(session or name or ("s" + secrets.token_hex(3)))
        state = session_ensure(host, sname, dry_run=dry_run)
        return {"ok": True, "id": "%s:tty:%s" % (host.name, sname), "mode": "tty",
                "session": sname, "state": state, "host": host.name, "note": host.notes}
    if not cmd:
        raise BashdError("start requires cmd (or mode=tty without cmd for a bare session)")
    sname = _check_sess_name(session or name or "main")
    jid = jid or new_id()
    state = job_start(host, jid, cmd, cwd, env, session=sname, dry_run=dry_run)
    return {"ok": True, "id": "%s:%s" % (host.name, jid), "mode": mode,
            "session": sname, "state": state, "host": host.name, "note": host.notes}


def do_read(host, kind, key, cursor_out=0, cursor_err=0, max_bytes=DEFAULT_MAX_BYTES,
            screen=False, dry_run=False):
    if kind == "job":
        r = job_read(host, key, cursor_out, cursor_err, max_bytes, dry_run=dry_run)
        if dry_run:
            return r
        return {"ok": True, "id": "%s:%s" % (host.name, key), "host": host.name, **r}
    r = tty_read(host, key, cursor_out, max_bytes, screen, dry_run=dry_run)
    if dry_run:
        return r
    out = {"ok": True, "id": "%s:tty:%s" % (host.name, key), "host": host.name,
           "alive": r["alive"], "status": "alive" if r["alive"] else "dead",
           "stdout": r["stdout"], "cursor_out": r["cursor"],
           "out_size": r["size"], "err_size": 0}
    if screen:
        out["screen"] = r["screen"]
    return out


def do_write(host, kind, key, data, append_newline=True, dry_run=False):
    if kind != "tty":
        raise BashdError("write is only supported on tty sessions (id host:tty:name)")
    return {"ok": True, **tty_write(host, key, data, append_newline, dry_run=dry_run)}


def do_signal(host, kind, key, sig="TERM", dry_run=False):
    if kind == "job":
        return {"ok": True, "id": "%s:%s" % (host.name, key), **job_signal(host, key, sig, dry_run=dry_run)}
    mode = "ctrl-c" if sig.upper() in ("INT", "CTRL-C", "C-C") else "kill"
    return {"ok": True, "id": "%s:tty:%s" % (host.name, key), **tty_signal(host, key, mode, dry_run=dry_run)}


def _compact_jobs(jobs):
    """Fleet-overview shape (v0.3.1): running jobs in full, finished ones
    summarized — a busy host with hundreds of finished records stays readable
    (and cheap in agent context) while everything live stays visible."""
    running = [j for j in jobs if j["running"]]
    # newest (smallest age from submit time) last, so recent_finished[-5:] = the 5 most recent
    finished = sorted((j for j in jobs if not j["running"]), key=lambda j: -(j.get("age_s") or 0))
    recent = [{"id": j["id"], "exit_code": j["exit_code"], "age_s": j.get("age_s"),
               "cmd": j.get("cmd")} for j in finished[-5:]]
    return {"running": running,
            "finished_count": len(finished),
            "finished_out_bytes": sum(j["out_bytes"] for j in finished),
            "recent_finished": recent}


def _probe_host(name, host):
    try:
        script = SESSIONS_TMPL.replace("__GRACE__", str(ORPHAN_GRACE_S))
        rc, out, err = exec_script(host, script, timeout_s=15)
        if rc != 0:
            return {"host": name, "reachable": True, "error": "remote script rc=%s %s" % (rc, err[-200:])}
        jobs, ttys = [], []
        section = None
        tmux_names = []
        for line in out.splitlines():
            if line == "BASHD_JOBS":
                section = "jobs"
            elif line == "BASHD_TTYS":
                section = "tty_names"
            elif line == "BASHD_TTYLOGS":
                section = "tty_logs"
            elif line == "BASHD_DONE":
                break
            elif section == "jobs":
                p = line.split("\t")
                if len(p) == 7:
                    jobs.append({"id": "%s:%s" % (name, p[0]), "running": p[1] == "-",
                                 "exit_code": _code_to_int(p[1]), "out_bytes": int(p[2]),
                                 "err_bytes": int(p[3]), "session": p[4],
                                 "age_s": _code_to_int(p[5]), "cmd": p[6]})
            elif section == "tty_names":
                if line.strip():
                    tmux_names.append(line.strip())
            elif section == "tty_logs":
                p = line.split("\t")
                if len(p) == 2:
                    ttys.append({"name": p[0], "id": "%s:tty:%s" % (name, p[0]),
                                 "alive": p[0] in tmux_names, "log_bytes": int(p[1])})
        return {"host": name, "reachable": True, "path": "local" if host.local else "ssh",
                "note": host.notes, "ttys": ttys, **_compact_jobs(jobs)}
    except Unreachable as e:
        return {"host": name, "reachable": False, "error": str(e)}
    except BashdError as e:
        return {"host": name, "reachable": False, "error": str(e)}


def do_sessions(host_name=None, hosts=None):
    hosts = hosts or load_config()
    if host_name:
        targets = {host_name: get_host(host_name, hosts)}
    else:
        targets = hosts
    with ThreadPoolExecutor(max_workers=min(8, len(targets) or 1)) as ex:
        results = list(ex.map(lambda kv: _probe_host(kv[0], kv[1]), sorted(targets.items())))
    return {"ok": True, "hosts": results}


def do_prune(host, host_name, dry_run=False, stale_s=None):
    """Remove finished job dirs and tty logs whose tmux session is dead.
    Before removal, a codeless job is finalized as 143 if its session is gone
    (target reboot, killed session) or — v0.3.1 — if it is a true orphan: lock
    free, all files older than ORPHAN_GRACE_S, and no job of its session holds
    a lock (nothing is executing or queued-startable). With stale_s, a codeless
    job whose out/err have BOTH been quiet for stale_s seconds is finalized
    too — the wedged-executor case; opt-in because a legitimately silent long
    run could match."""
    script = r'''
umask 077
n=0
tmux -L bashd list-sessions -F '#S' 2>/dev/null | sort > /tmp/.bashd_alive.$$ || : > /tmp/.bashd_alive.$$
__STALE_INIT__
haveflock=0; command -v flock >/dev/null 2>&1 && haveflock=1
oref=""
[ "$haveflock" = 1 ] && { oref="/tmp/.bashd_oref.$$"; touch -d "@$(( $(date +%s) - __GRACE__ ))" "$oref" 2>/dev/null || oref=""; }
for d in "$HOME"/.bashd/jobs/*/; do
  [ -d "$d" ] || continue
  if [ ! -f "$d/code" ] && [ -f "$d/lock" ]; then
    s=$(cat "$d/session" 2>/dev/null)
    dead=0
    if [ -z "$s" ] || ! grep -qx "$s" /tmp/.bashd_alive.$$; then dead=1; fi
    if [ "$dead" = 0 ] && [ -n "$oref" ] && [ "$d/lock" -ot "$oref" ] \
      && [ ! "$d/out" -nt "$oref" ] && [ ! "$d/err" -nt "$oref" ] \
      && flock -n "$d/lock" true 2>/dev/null; then
      busy=0
      for jl in "$HOME"/.bashd/jobs/*/lock; do
        [ -f "$jl" ] || continue
        jd=$(dirname "$jl")
        [ "$(cat "$jd/session" 2>/dev/null)" = "$s" ] || continue
        [ -f "$jd/code" ] && continue
        flock -n "$jl" true 2>/dev/null || { busy=1; break; }
      done
      [ "$busy" = 0 ] && dead=1
    fi
__STALE_CHECK__
    [ "$dead" = 1 ] && echo 143 > "$d/code"
  fi
  if [ -f "$d/code" ]; then rm -rf "$d" && n=$((n+1)); fi
done
t=0
for l in "$HOME"/.bashd/tmux/*.log; do
  [ -f "$l" ] || continue
  b=$(basename "$l" .log)
  grep -qx "$b" /tmp/.bashd_alive.$$ || { rm -f "$l" && t=$((t+1)); }
done
rm -f /tmp/.bashd_alive.$$ ; [ -n "$oref" ] && rm -f "$oref"
echo "BASHD_PRUNED jobs=$n logs=$t"
'''
    script = script.replace("__GRACE__", str(ORPHAN_GRACE_S))
    if stale_s:
        script = script.replace(
            "__STALE_INIT__",
            'ref="/tmp/.bashd_stale.$$"; '
            'touch -d "@$(( $(date +%s) - __STALE_SECS__ ))" "$ref" 2>/dev/null || ref=""; '
        ).replace("__STALE_SECS__", str(max(1, int(stale_s)))).replace(
            "__STALE_CHECK__",
            '    if [ "$dead" = 0 ] && [ -n "$ref" ] && [ "$d/out" -ot "$ref" ] '
            '&& [ "$d/err" -ot "$ref" ]; then dead=1; fi\n')
    script = script.replace("__STALE_INIT__", "").replace("__STALE_CHECK__", "")
    if dry_run:
        return {"dry_run": exec_argv_preview(host, script)}
    out = exec_script(host, script, timeout_s=60)[1]
    m = re.search(r"BASHD_PRUNED jobs=(\d+) logs=(\d+)", out)
    if not m:
        raise BashdError("prune: unexpected output from %s" % host_name)
    res = {"ok": True, "host": host_name, "jobs_removed": int(m.group(1)),
           "tty_logs_removed": int(m.group(2))}
    if stale_s:
        res["stale_s"] = int(stale_s)
    return res


def do_hosts():
    return {"ok": True, "hosts": [h.describe() for _, h in sorted(load_config().items())]}


def do_paths(host_name=None, repath=False):
    """Per-host route table: paths with costs, sticky/cheapest, probe state.
    repath=True probes paths cheaper than the current sticky one right now."""
    hosts = load_config()
    targets = {host_name: get_host(host_name, hosts)} if host_name else hosts
    res = {"ok": True, "hosts": []}
    for name in sorted(targets):
        h = targets[name]
        rep = repath_probe(h) if (repath and not h.local and len(h.paths) > 1) else None
        st = load_state()
        si = (st.get("path") or {}).get(name)
        pr = (st.get("probe") or {}).get(name) or {}
        entry = {"host": name, "local": h.local, "sticky": si,
                 "cheapest": cheapest_path_idx(h),
                 "probe_backoff_s": pr.get("backoff"),
                 "probe_next_in_s": (round(pr["next_ts"] - time.time(), 1)
                                     if pr.get("next_ts") else None),
                 "paths": [{"idx": i, "cost": p.get("cost", i), "sticky": i == si,
                            "desc": _path_desc(p)} for i, p in enumerate(h.paths)]}
        if rep:
            entry["repath"] = rep
        res["hosts"].append(entry)
    return res


