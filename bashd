def _kv(pairs):
    out = {}
    for p in pairs or []:
        if "=" not in p:
            raise BashdError("bad --env %r (want KEY=VALUE)" % p)
        k, v = p.split("=", 1)
        out[k] = v
    return out


def build_parser():
    ap = argparse.ArgumentParser(prog="bashd", description=__doc__.splitlines()[0])
    ap.add_argument("--version", action="version", version="bashd %s" % VERSION)
    sub = ap.add_subparsers(dest="cmd_", required=True)

    p = sub.add_parser("run", help="sync run inside the persistent session (timeout detaches)")
    p.add_argument("host"), p.add_argument("cmd", nargs="+")
    p.add_argument("--session", default="main", help="persistent session (env/cwd persist per session)")
    p.add_argument("--timeout", dest="timeout_s", type=float, default=120)
    p.add_argument("--max-bytes", dest="max_bytes", type=int, default=DEFAULT_MAX_BYTES)
    p.add_argument("--cwd"), p.add_argument("--env", action="append")
    p.add_argument("--id", help="client-chosen job id (idempotent retries)")
    p.set_defaults(fn=cli_run)

    p = sub.add_parser("start", help="submit a command (or create a tty session), return id")
    p.add_argument("host"), p.add_argument("cmd", nargs="*")
    p.add_argument("--mode", choices=["batch", "tty"], default="batch")
    p.add_argument("--session", help="session name (default 'main'; tty default: random)")
    p.add_argument("--name", help="alias for --session (tty style)")
    p.add_argument("--cwd"), p.add_argument("--env", action="append")
    p.add_argument("--id"), p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cli_start)

    p = sub.add_parser("read", help="read output since cursors")
    p.add_argument("id")
    p.add_argument("--cursor-out", dest="cursor_out", type=int, default=0)
    p.add_argument("--cursor-err", dest="cursor_err", type=int, default=0)
    p.add_argument("--max-bytes", dest="max_bytes", type=int, default=DEFAULT_MAX_BYTES)
    p.add_argument("--screen", action="store_true", help="tty: include live pane")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cli_read)

    p = sub.add_parser("wait", help="block until exit|regex|idle or timeout")
    p.add_argument("id")
    p.add_argument("--timeout", dest="timeout_s", type=float, default=120)
    p.add_argument("--until", choices=["exit", "regex", "idle"], default="exit")
    p.add_argument("--pattern"), p.add_argument("--idle-s", dest="idle_s", type=float, default=2.0)
    p.add_argument("--max-bytes", dest="max_bytes", type=int, default=DEFAULT_MAX_BYTES)
    p.add_argument("--until-reachable", dest="until_reachable", action="store_true")
    p.set_defaults(fn=cli_wait)

    p = sub.add_parser("write", help="send stdin to a tty session")
    p.add_argument("id"), p.add_argument("data")
    p.add_argument("--no-newline", dest="no_newline", action="store_true")
    p.set_defaults(fn=cli_write)

    p = sub.add_parser("signal", help="signal job (TERM/KILL/INT/HUP) or tty (INT=C-c, else kill)")
    p.add_argument("id"), p.add_argument("--sig", default="TERM")
    p.set_defaults(fn=cli_signal)

    p = sub.add_parser("sessions", help="fleet overview (jobs + ttys per host)")
    p.add_argument("host", nargs="?")
    p.set_defaults(fn=cli_sessions)

    p = sub.add_parser("prune", help="remove finished job records + dead tty logs on a host")
    p.add_argument("host")
    p.add_argument("--stale", dest="stale_s", type=float, default=None,
                   help="also reap codeless jobs quiet this many seconds "
                        "(session alive but wedged; opt-in)")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cli_prune)

    p = sub.add_parser("hosts", help="show host registry")
    p.set_defaults(fn=cli_hosts)

    p = sub.add_parser("term", help="human terminal on a persistent session (v0.4)")
    p.add_argument("host")
    p.add_argument("--session", default="main",
                   help="persistent session to attach to (default 'main')")
    p.add_argument("--mode", choices=["auto", "live", "turn"], default="auto",
                   help="auto: live (raw passthrough) on good links, turn (line editor) "
                        "on slow/unstable ones; ~l/~t switch at runtime")
    p.add_argument("--no-wire", dest="no_wire", action="store_true",
                   help="skip the wire transport; one ssh call per operation instead")
    p.add_argument("--scrollback", type=int, default=TERM_ATTACH_BYTES,
                   help="bytes of session history shown at attach (default %(default)s)")
    p.set_defaults(fn=cli_term)

    p = sub.add_parser("paths", help="per-host route table (cost / sticky / repath-probe state)")
    p.add_argument("host", nargs="?")
    p.add_argument("--repath", action="store_true",
                   help="probe paths cheaper than the sticky one now, re-latch the first that works")
    p.set_defaults(fn=cli_paths)

    p = sub.add_parser("_repath-probe", help=argparse.SUPPRESS)
    p.add_argument("host")
    p.set_defaults(fn=lambda a: _print(repath_probe(get_host(a.host))))

    p = sub.add_parser("mcp", help="run as MCP stdio server")
    p.set_defaults(fn=lambda a: mcp_server())

    p = sub.add_parser("selftest", help="run built-in end-to-end tests (local substrate)")
    p.set_defaults(fn=lambda a: sys.exit(selftest()))

    return ap


# ---------------------------------------------------------------- selftest

def selftest():
    tmp = tempfile.mkdtemp(prefix="bashd-selftest-")
    os.environ["BASHD_HOME"] = tmp
    set_home(tmp)
    os.makedirs(os.path.join(tmp, ".bashd-internal"), exist_ok=True)
    with open(os.path.join(tmp, "hosts.json"), "w") as f:
        json.dump({"hosts": {"local": {}}}, f)
    os.makedirs(HOME_DIR, exist_ok=True)

    results = []

    def check(name, fn):
        try:
            fn()
            results.append((name, True, ""))
            print("PASS %s" % name)
        except Exception as e:  # noqa: BLE001
            results.append((name, False, str(e)))
            print("FAIL %s: %s" % (name, e))

    H = get_host("local", load_config())

    def stid():
        return "st" + secrets.token_hex(3)

    def t_run():
        # NB: no bare `exit` — it would kill the persistent session (by design)
        r = do_run(H, "echo out1; echo err1 >&2; sh -c 'exit 3'", timeout_s=20, jid=stid())
        assert r["status"] == "done" and r["exit_code"] == 3, r
        assert r["stdout"].strip() == "out1" and r["stderr"].strip() == "err1", r
    check("run sync + streams + exit code", t_run)

    def t_run_env():
        r = do_run(H, 'printf "%s-%s" "$A" "$PWD"', cwd="/tmp", env={"A": "vv"},
                   timeout_s=20, jid=stid())
        assert r["exit_code"] == 0 and r["stdout"] == "vv-/tmp", r
    check("run cwd + env", t_run_env)

    def t_persist():
        v = "PV" + secrets.token_hex(2).upper()
        do_run(H, "export %s=hello" % v, timeout_s=20, jid=stid())
        r = do_run(H, 'printf "%%s" "$%s"' % v, timeout_s=20, jid=stid())
        assert r["stdout"] == "hello", r
        do_run(H, "pwd", cwd="/tmp", timeout_s=20, jid=stid())
        r2 = do_run(H, "pwd", timeout_s=20, jid=stid())
        assert r2["stdout"].strip() == "/tmp", r2
    check("persistent env + cwd across runs", t_persist)

    def t_isolation():
        v = "IV" + secrets.token_hex(2).upper()
        do_run(H, "export %s=secret" % v, timeout_s=20, session="iso1", jid=stid())
        r = do_run(H, 'printf "%%s" "${%s-}"' % v, timeout_s=20, jid=stid())
        assert r["stdout"] == "", r
        r2 = do_run(H, 'printf "%%s" "$%s"' % v, timeout_s=20, session="iso1", jid=stid())
        assert r2["stdout"] == "secret", r2
    check("sessions isolate environments", t_isolation)

    def t_detach():
        r = do_run(H, "sleep 5; echo late", timeout_s=1, jid=stid())
        assert r["status"] == "running" and r["timed_out"], r
        w = do_wait(H, *parse_id(r["id"])[1:], timeout_s=20)
        assert w["status"] == "done" and "late" in w["stdout"], w
    check("timeout detaches + wait resumes", t_detach)

    def t_idem():
        jid = stid()
        s1 = job_start(H, jid, "echo once")
        s2 = job_start(H, jid, "echo once")
        assert s1 == "started" and s2 in ("exists", "done-exists"), (s1, s2)
        w = do_wait(H, "job", jid, timeout_s=10)
        assert w["stdout"].strip() == "once", w
    check("idempotent start", t_idem)

    def t_cursor():
        r = do_run(H, "seq 1 100", timeout_s=20, jid=stid())
        h, kind, key = parse_id(r["id"])
        c1 = job_read(h, key, 0, 0, 10)
        assert len(c1["stdout"]) == 10 and c1["cursor_out"] == 10, c1
        c2 = job_read(h, key, c1["cursor_out"], 0, 4096)
        assert c2["cursor_out"] == c2["out_size"], c2
        assert c2["status"] == "done" and c2["exit_code"] == 0, c2
        full = c1["stdout"] + c2["stdout"]
        assert full == "".join("%d\n" % i for i in range(1, 101)), "reassembled stream wrong"
    check("cursor reads", t_cursor)

    def t_regex():
        jid = stid()
        job_start(H, jid, "sleep 1; echo READY_NOW")
        w = do_wait(H, "job", jid, timeout_s=15, until="regex", pattern="READY_NOW")
        assert w["match"] == "READY_NOW", w
    check("wait until=regex", t_regex)

    def t_idle():
        jid = stid()
        job_start(H, jid, "echo tick; sleep 30")
        w = do_wait(H, "job", jid, timeout_s=10, until="idle", idle_s=1.0)
        assert w["status"] == "running" and "tick" in w["stdout"], w
        job_signal(H, jid, "KILL")
        time.sleep(0.5)
        r = job_read(H, jid, 0, 0, 100)
        assert r["exit_code"] == 130, r
    check("wait until=idle + signal ctrl-c (130)", t_idle)

    def t_exit_hazard():
        # v0.2.1: the read finalizes the orphaned record as 143 ("terminated,
        # exact code unrecorded") instead of reporting an open-ended "dead"
        r = do_run(H, "exit 0", timeout_s=15, jid=stid())
        assert r["status"] == "done" and r["exit_code"] == 143, r
        r2 = do_run(H, "echo recovered", timeout_s=20, jid=stid())
        assert r2["status"] == "done" and r2["stdout"].strip() == "recovered", r2
    check("`exit` kills session; record finalized 143; auto-recreates", t_exit_hazard)

    def t_notfound():
        try:
            job_read(H, stid())
            raise AssertionError("expected NotFound")
        except NotFound:
            pass
    check("missing job handled", t_notfound)

    def t_sessions():
        r = do_sessions("local")
        hst = r["hosts"][0]
        assert hst["reachable"], hst
        assert "running" in hst and "finished_count" in hst, hst
        assert hst["finished_count"] >= 1, hst  # earlier tests left finished jobs
        assert all("cmd" in j and "age_s" in j for j in hst["running"]), hst
        jid = stid()
        job_start(H, jid, "echo listed", session="listsess")
        do_wait(H, "job", jid, timeout_s=10)
        r2 = do_sessions("local")["hosts"][0]
        assert any(j["id"].endswith(":" + jid) and j["cmd"].startswith("echo listed")
                   for j in r2["recent_finished"]), r2["recent_finished"]
    check("sessions listing (compact: running full + finished summary)", t_sessions)

    def t_atomic_concurrent():
        # v0.3.1 regression test: several clients submitting into ONE session
        # at once (mixed payload sizes) — every job must run exactly once and
        # record its code; nothing may stay 'running' forever. NB: random ids —
        # a fixed id would collide with a previous run's leftover record
        # (done-exists) and fake a failure.
        import subprocess as sp
        sess = "st" + secrets.token_hex(3)
        ids = ["stc" + secrets.token_hex(3) for _ in range(6)]
        procs = []
        for i, jid in enumerate(ids):
            payload = "echo C%d-OK" % i if i % 2 else "echo C%d-%s" % (i, "y" * 2400)
            procs.append(sp.Popen(["python3", os.path.abspath(__file__), "run",
                                   "--session", sess, "--timeout", "60",
                                   "--id", jid, "local", payload],
                                  stdout=sp.DEVNULL, stderr=sp.DEVNULL))
        rc = [p.wait(timeout=90) for p in procs]
        assert all(c == 0 for c in rc), rc
        for i, jid in enumerate(ids):
            r = job_read(H, jid)
            assert r["status"] == "done" and r["exit_code"] == 0, (i, r)
            assert ("C%d-OK" % i) in r["stdout"] or ("C%d-y" % i) in r["stdout"], (i, r)
    check("concurrent submits into one session all finalize", t_atomic_concurrent)

    def t_guard_fd9_fork():
        # 2026-10-02 fleet-incident regression: the submit guard holds the
        # session's submit flock on fd 9 while SESS_ENSURE runs; when the tmux
        # server doesn't exist yet, new-session forks it and the server used to
        # inherit that locked fd — the session's submit lock then stayed held
        # for the server's lifetime and every later submit blocked (flock -w 50
        # > any sane client timeout). Fix closes fd 9 across the new-session
        # call; on a throwaway tmux socket, once the submitter releases its own
        # fd the lock must be FREE.
        s = stid()
        sock = "bashd-selftest-" + s
        lock = os.path.join(os.path.expanduser("~/.bashd"), ".submit-%s.lock" % s)
        ensure = (SESS_ENSURE.replace("__SESS__", s)
                             .replace("__INIT__", "export BASHD_SESSION='%s'" % s)
                             .replace("-L bashd", "-L " + sock))
        script = (
            'exec 9>%(lock)s\n'
            'flock -w 5 9 || { echo GUARD-FAIL; exit 9; }\n'
            '%(ensure)s\n'
            'tmux -L %(sock)s has-session -t %(s)s 2>/dev/null || { echo NO-SESSION; exit 8; }\n'
            'exec 9>&-\n'
            'if flock -n "%(lock)s" true 2>/dev/null; then echo LOCK-FREE-OK; '
            'else echo LOCK-HELD-BUG; fi\n'
            'tmux -L %(sock)s kill-server 2>/dev/null\n'
            'rm -f "%(lock)s"\n'
        ) % {"lock": lock, "ensure": ensure, "sock": sock, "s": s}
        r = do_run(H, script, timeout_s=30, jid=stid())
        assert "LOCK-FREE-OK" in r["stdout"] and "LOCK-HELD-BUG" not in r["stdout"], r
    check("server fork under submit guard leaves lock free (fd9 regression)", t_guard_fd9_fork)

    def t_orphan_heal():
        # v0.3.1: a codeless, lock-free, quiet job whose session is ALIVE is a
        # dead orphan (its submit lines were lost) — read finalizes it as 143;
        # but while ANY job of that session holds its lock (executing/queued),
        # siblings must NOT be finalized.
        sess = "st" + secrets.token_hex(3)
        session_ensure(H, sess)
        base = os.path.join(os.path.expanduser("~/.bashd"), "jobs")  # real substrate

        def fake(jid, age_s):
            d = os.path.join(base, jid)
            os.makedirs(d, exist_ok=True)
            open(os.path.join(d, "session"), "w").write(sess)
            for f in ("lock", "out", "err"):
                open(os.path.join(d, f), "w").close()
            old = time.time() - max(age_s, 1)
            for f in ("lock", "out", "err"):
                os.utime(os.path.join(d, f), (old, old))
            return d

        orphan = fake("storphan1", ORPHAN_GRACE_S + 60)
        r = job_read(H, "storphan1")
        assert r["status"] == "done" and r["exit_code"] == 143, r

        # held sibling protects a queued-looking codeless job from finalization
        held = os.path.join(base, "stheld1")
        os.makedirs(held, exist_ok=True)
        open(os.path.join(held, "session"), "w").write(sess)
        open(os.path.join(held, "lock"), "w").close()
        holder = subprocess.Popen(["flock", os.path.join(held, "lock"),
                                   "-c", "sleep 4"])
        time.sleep(0.3)
        queued = fake("stqueued1", ORPHAN_GRACE_S + 60)
        r2 = job_read(H, "stqueued1")
        assert r2["status"] == "running", r2  # session busy -> not an orphan
        holder.wait()
        r3 = job_read(H, "stqueued1")
        assert r3["status"] == "done" and r3["exit_code"] == 143, r3
    check("orphan finalize: heals stale, spares queued-behind-held", t_orphan_heal)

    def t_mcp():
        import itertools
        p = subprocess.Popen([os.path.abspath(__file__), "mcp"],
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, text=True)
        msgs = [
            json.dumps({"jsonrpc": "2.0", "id": 1, "method": "initialize",
                        "params": {"protocolVersion": "2024-11-05"}}),
            json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}),
            json.dumps({"jsonrpc": "2.0", "id": 2, "method": "tools/list"}),
            json.dumps({"jsonrpc": "2.0", "id": 3, "method": "tools/call",
                        "params": {"name": "bash_run",
                                   "arguments": {"cmd": "echo mcp_ok", "timeout_s": 20,
                                                 "id": "st" + secrets.token_hex(3)}}}),
        ]
        try:
            out, _ = p.communicate("\n".join(msgs) + "\n", timeout=60)
        finally:
            if p.poll() is None:
                p.kill()
        replies = {}
        for line in out.splitlines():
            try:
                m = json.loads(line)
                replies[m.get("id")] = m
            except ValueError:
                pass
        assert 1 in replies and 2 in replies and 3 in replies, replies
        tools = replies[2]["result"]["tools"]
        assert len(tools) == 9, tools
        payload = json.loads(replies[3]["result"]["content"][0]["text"])
        assert payload["status"] == "done" and payload["stdout"].strip() == "mcp_ok", payload
    check("MCP stdio roundtrip", t_mcp)

    def t_tty():
        if not shutil.which("tmux"):
            print("SKIP tty tests (no tmux)")
            return
        name = "st" + secrets.token_hex(3)
        s = do_start(H, mode="tty", name=name)
        assert s["id"].endswith(":tty:" + name) and s["state"] == "ok", s
        wr = do_write(H, "tty", name, "echo inter_$((5*8))")
        assert wr["ok"], wr
        w = do_wait(H, "tty", name, timeout_s=20, until="regex", pattern=r"inter_40")
        assert w["match"] == "inter_40", w
        rd = do_read(H, "tty", name, screen=True)
        assert "inter_40" in rd.get("screen", ""), rd
        sg = do_signal(H, "tty", name, "KILL")
        assert sg["action"] == "killed", sg
    check("interactive tty session (write/screen/kill)", t_tty)

    def t_write_nonl():
        # v0.4 fix: append_newline=False must send EXACTLY the bytes — the
        # Enter send used to land in the script unconditionally, executing the
        # half-line behind bash_write's back (fatal for term's raw typing)
        name = "st" + secrets.token_hex(3)
        do_start(H, mode="tty", name=name)
        do_write(H, "tty", name, "echo mk_$((6*7))x", append_newline=False)
        time.sleep(0.8)
        r1 = do_read(H, "tty", name)
        assert "echo mk_" in r1["stdout"] and "mk_42x" not in r1["stdout"], r1
        do_write(H, "tty", name, "", append_newline=True)
        w = do_wait(H, "tty", name, timeout_s=10, until="regex", pattern="mk_42x")
        assert w["match"] == "mk_42x", w
        do_signal(H, "tty", name, "KILL")
    check("tty write append_newline=False does not execute", t_write_nonl)

    def t_hop():
        # nested ssh hop, end-to-end through this machine's own sshd (skip if no self-auth)
        pre = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o",
                              "StrictHostKeyChecking=accept-new", "-o", "ConnectTimeout=5",
                              "127.0.0.1", "echo ok"], capture_output=True, timeout=20)
        if pre.returncode != 0:
            print("SKIP hop test (no ssh self-auth)")
            return
        h = Host("hoptest", {"ssh": "127.0.0.1", "paths": [{"hop": "127.0.0.1"}]})
        argv = _ssh_argv_for_path(h, h.paths[0])
        assert argv.count("ControlMaster=auto") == 2, argv  # outer + inner legs
        r = do_run(h, "echo hop_ok", timeout_s=30)
        assert r["status"] == "done" and r["stdout"].strip() == "hop_ok", r
    check("nested hop path (mux on both legs)", t_hop)

    def t_repath():
        # cost-aware routing: cheap path 0 behind a shimmed ssh we can kill,
        # expensive path 1; sync repath, background auto re-latch, attempt trace
        bindir = os.path.join(tmp, "shim-bin")
        os.makedirs(bindir, exist_ok=True)
        shim = os.path.join(bindir, "ssh")
        with open(shim, "w") as f:
            f.write('#!/bin/sh\n'
                    'if [ "$BASHD_SHIM_MODE" = "deadall" ]; then\n'
                    '  echo "ssh: connect to host 203.0.113.7 port 22: Connection refused" >&2\n'
                    '  exit 255\n'
                    'fi\n'
                    'for a in "$@"; do\n'
                    '  if [ "$a" = "PATH0MARK" ] && [ "$BASHD_SHIM_MODE" = "dead0" ]; then\n'
                    '    echo "ssh: connect to host 203.0.113.7 port 22: Connection refused" >&2\n'
                    '    exit 255\n'
                    '  fi\n'
                    'done\n'
                    'exec /bin/sh -s\n')
        os.chmod(shim, 0o755)
        old_path = os.environ.get("PATH")
        os.environ["PATH"] = bindir + os.pathsep + (old_path or "")
        old_shim = os.environ.pop("BASHD_SHIM_MODE", None)
        try:
            cfg = {"ssh": "shimhost",
                   "paths": [{"args": ["PATH0MARK"], "cost": 1}, "direct"]}
            try:
                Host("badcost", {"paths": [{"cost": "cheap"}]})
                raise AssertionError("bad cost accepted")
            except BashdError:
                pass
            with open(os.path.join(HOME_DIR, "hosts.json"), "w") as f:
                json.dump({"hosts": {"local": {}, "pathtest": cfg}}, f)
            h = Host("pathtest", cfg)

            os.environ["BASHD_SHIM_MODE"] = "dead0"
            r = do_run(h, "echo via1", timeout_s=25, jid=stid())
            assert r["status"] == "done" and r["stdout"].strip() == "via1", r
            assert sticky_path_idx(h) == 1, sticky_path_idx(h)  # fell over to the expensive path

            dp = do_paths("pathtest")["hosts"][0]
            assert dp["cheapest"] == 0 and dp["paths"][0]["cost"] == 1, dp

            os.environ["BASHD_SHIM_MODE"] = "ok"
            rep = repath_probe(h)
            assert rep["action"] == "relatched" and rep["path"] == 0, rep
            assert sticky_path_idx(h) == 0
            assert repath_probe(h)["reason"] == "already on cheapest path"

            # background auto-probe: sticky back on the expensive path, cheap
            # path alive again, probe gate open -> a detached child re-latches
            note_sticky_path(h, 1)
            stt = load_state()
            stt.setdefault("probe", {})["pathtest"] = {"backoff": 5, "next_ts": 0}
            save_state(stt)
            maybe_spawn_repath_probe(h)
            for _ in range(60):
                if sticky_path_idx(h) == 0:
                    break
                time.sleep(0.1)
            assert sticky_path_idx(h) == 0, \
                "background probe did not re-latch: %s" % load_state()

            # total outage: error carries the per-path attempt trail
            os.environ["BASHD_SHIM_MODE"] = "deadall"
            try:
                exec_script(h, "echo x", 10)
                raise AssertionError("expected Unreachable")
            except Unreachable as e:
                assert "path0:unreachable" in str(e) and "path1:unreachable" in str(e), e
        finally:
            os.environ.pop("BASHD_SHIM_MODE", None)
            if old_shim is not None:
                os.environ["BASHD_SHIM_MODE"] = old_shim
            if old_path is None:
                os.environ.pop("PATH", None)
            else:
                os.environ["PATH"] = old_path
            with open(os.path.join(HOME_DIR, "hosts.json"), "w") as f:
                json.dump({"hosts": {"local": {}}}, f)
    check("cost-aware repath (sync + background) + attempt trail", t_repath)

    def t_wire():
        # v0.4 wire transport e2e: HELO caps, push, cursor math, RTT, gzip
        # payloads, Ctrl-C, resize, GONE, and auto-reconnect with no gaps/dups
        if not shutil.which("tmux"):
            print("SKIP wire test (no tmux)")
            return
        name = "st" + secrets.token_hex(3)
        session_ensure(H, name)
        acc = bytearray()
        gone = threading.Event()
        events = []

        def cb(data):
            if data is None:
                gone.set()
                return
            acc.extend(data)

        ch = WireChannel(H, on_event=lambda k, i: events.append((k, i)))
        info = ch.connect()
        assert info["ver"] == 1 and ch.flavor in ("bash", "sh"), info
        sz = tty_read(H, name, 0, 1)["size"]
        ch.sub(name, sz, cb)
        ch.write(name, b"echo wire_$((5*9))\r")
        poll_cur = [sz]

        def wait_marker(marker, timeout=15):
            end = time.time() + timeout
            while time.time() < end:
                if marker in acc:
                    return True
                if not ch.push:  # sh flavor: no push, poll explicitly
                    r = ch.read(name, poll_cur[0], WIRE_PUSH_MAX)
                    if r["data"]:
                        acc.extend(r["data"])
                        poll_cur[0] = r["cursor"]
                time.sleep(0.15)
            return False

        assert wait_marker(b"wire_45"), bytes(acc[-400:])
        r = ch.read(name, 0, 2000)
        assert r["cursor"] == len(r["data"]) and r["size"] >= r["cursor"], r
        assert r["alive"] and b"wire_45" in r["data"], r
        rt = ch.ping()
        assert rt is not None and 0 <= rt < 10, rt
        # a >= WIRE_GZ_MIN byte write exercises the gzip payload path
        ch.write(name, b"echo " + b"K" * 4200 + b"\r")
        assert wait_marker(b"K" * 64, timeout=20), "big gzip-tagged write never echoed"
        ch.write(name, b"sleep 30\r")
        time.sleep(0.5)
        ch.signal(name, "int")
        assert wait_marker(b"^C", timeout=10), "no ^C after signal"
        ch.resize(name, 101, 33)
        time.sleep(0.8)
        out = exec_script(H, "tmux -L bashd display-message -p -t %s "
                              "'#{window_width} #{window_height}'" % name, 10)[1]
        assert "101 33" in out, out
        occ = bytes(acc).count(b"wire_45")
        exec_script(H, "tmux -L bashd kill-session -t %s" % name, 10)
        if ch.push:
            assert gone.wait(10), "no GONE after kill-session"
        # auto-reconnect: monitor re-spawns, re-subs at the delivered cursor
        ch._die("selftest")
        deadline = time.time() + 20
        while ch.dead and time.time() < deadline:
            time.sleep(0.2)
        assert not ch.dead, "monitor did not reconnect"
        session_ensure(H, name)  # log appends: cursor continuity must hold
        ch.sub(name, ch.cursors.get(name, 0), cb)
        ch.write(name, b"echo back_$((2*3))\r")
        assert wait_marker(b"back_6", timeout=15), bytes(acc[-400:])
        assert bytes(acc).count(b"wire_45") == occ, "output span duplicated after reconnect"
        ch.close()
    check("wire transport (frames/push/rtt/signal/resize/GONE/reconnect)", t_wire)

    def t_term():
        # v0.4 human terminal e2e over a pty: header, turn mode (line editor +
        # remote echo), live mode (raw passthrough + ~. escape), clean exit,
        # session survives
        if not shutil.which("tmux"):
            print("SKIP term test (no tmux)")
            return
        import pty as _pty

        def wait_for(m, buf, needle, timeout=25):
            end = time.time() + timeout
            while time.time() < end:
                r, _, _ = select.select([m], [], [], 0.3)
                if r:
                    try:
                        buf.extend(os.read(m, 65536))
                    except OSError:
                        return False
                if needle in buf:
                    return True
            return False

        def case(mode, script, sess):
            m, s = _pty.openpty()
            fcntl.ioctl(m, termios.TIOCSWINSZ, struct.pack("HHHH", 24, 80, 0, 0))
            env = dict(os.environ, BASHD_HOME=tmp)
            p = subprocess.Popen([sys.executable, os.path.abspath(__file__), "term",
                                  "local", "--session", sess, "--mode", mode],
                                 stdin=s, stdout=s, stderr=s, env=env)
            os.close(s)
            buf = bytearray()
            try:
                assert wait_for(m, buf, "term —".encode()), bytes(buf[-500:])
                for send, expect in script:
                    os.write(m, send)
                    assert wait_for(m, buf, expect), \
                        "missing %r in %r" % (expect, bytes(buf[-500:]))
                if mode == "turn":
                    os.write(m, b"~.\r")
                else:  # live: ssh-style ~. (two chunks, tests the hold)
                    os.write(m, b"~")
                    time.sleep(0.05)
                    os.write(m, b".")
                try:
                    rc = p.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    p.kill()
                    rc = -1
                assert rc == 0, rc
            finally:
                if p.poll() is None:
                    p.kill()
                try:
                    os.close(m)
                except OSError:
                    pass

        case("turn", [(b"echo t_$((6*7))\r", b"t_42")], "st" + secrets.token_hex(3))
        case("live", [(b"echo l_$((3*3))\r", b"l_9")], "st" + secrets.token_hex(3))
    check("term: human terminal e2e over a pty (turn + live)", t_term)

    def t_wire_shim():
        # The shim transport (an ssh that's actually a plain local sh) proves:
        # the bash-agent guard falls back to the sh flavor, and the channel
        # works over it. Latency-driven mode choice is a unit contract.
        bindir = os.path.join(tmp, "shim3-bin")
        os.makedirs(bindir, exist_ok=True)
        shim = os.path.join(bindir, "ssh")
        with open(shim, "w") as f:
            f.write('#!/bin/sh\nexec /bin/sh -s\n')
        os.chmod(shim, 0o755)
        old_path = os.environ.get("PATH")
        os.environ["PATH"] = bindir + os.pathsep + (old_path or "")
        try:
            h = Host("slowtest", {"ssh": "slowhost", "paths": ["direct"]})
            ch = WireChannel(h)
            info = ch.connect()
            r = ch.ping(timeout=10)
            ch.close()
            # /bin/sh runs the bash agent -> guard exits rc 9 -> sh flavor wins
            assert info["flavor"] == "sh" and info["push"] is False, info
            assert r is not None and 0 <= r < 10, r
            assert _term_decide_mode("auto", [r, r], "wire", False) in ("live", "turn")
            assert _term_decide_mode("auto", [0.9, 1.1, 0.8], "wire", False) == "turn"
            assert _term_decide_mode("auto", [0.05, 0.06], "wire", False) == "live"
            assert _term_decide_mode("auto", [0.4], "wire", False) == "live"   # wire tolerates <= 0.7
            assert _term_decide_mode("auto", [0.4], "exec", False) == "turn"   # exec needs < 0.25
            assert _term_decide_mode("auto", [0.05], "exec", False) == "live"
            assert _term_decide_mode("auto", [0.05], "exec", True) == "live"
            assert _term_decide_mode("turn", [0.01], "wire", False) == "turn"  # pinned wins
            assert _term_decide_mode("auto", [], "wire", False) == "turn"      # no samples
        finally:
            if old_path is None:
                os.environ.pop("PATH", None)
            else:
                os.environ["PATH"] = old_path
    check("wire sh-flavor fallback via shim + input-mode decision rules", t_wire_shim)

    def t_prune():
        h = get_host("local", load_config())
        jid = stid()
        job_start(h, jid, "true")
        w = do_wait(h, "job", jid, timeout_s=10)
        assert w["status"] == "done", w
        r = do_prune(h, "local")
        assert r["jobs_removed"] >= 1, r
    check("prune finished jobs", t_prune)

    def t_finalize():
        # kill the session out from under a running job: the record must come
        # back finalized (143) from the next read, and prune must sweep it
        sess = "st" + secrets.token_hex(3)
        jid = stid()
        job_start(H, jid, "echo soon; sleep 30", session=sess)
        time.sleep(1.0)
        exec_script(H, "tmux -L bashd kill-session -t %s" % sess, 10)
        r = job_read(H, jid)
        assert r["status"] == "done" and r["exit_code"] == 143, r
        assert "soon" in r["stdout"], r
        do_prune(H, "local")
        exec_script(H, "test ! -d \"$HOME/.bashd/jobs/%s\"" % jid, 10)
    check("dead session finalizes job as 143 on read", t_finalize)

    def t_prune_stale():
        # session-alive but wedged: opt-in reaping by output quiet time
        sess = "st" + secrets.token_hex(3)
        jid = stid()
        job_start(H, jid, "echo quiet_test; sleep 8", session=sess)
        time.sleep(1.6)  # out/err mtimes now ~1.5 s old
        r = do_prune(H, "local", stale_s=1)
        exec_script(H, "test ! -d \"$HOME/.bashd/jobs/%s\"" % jid, 10)
    check("prune --stale reaps quiet codeless jobs", t_prune_stale)

    def t_cleanup():
        # selftest jobs live on the real local substrate (~/.bashd) — remove our st* artifacts
        exec_script(H, r'''
tmux -L bashd list-sessions -F '#S' 2>/dev/null | grep '^st' | while read -r s; do
  tmux -L bashd kill-session -t "$s" 2>/dev/null
done
rm -rf "$HOME"/.bashd/jobs/st* "$HOME"/.bashd/tmux/st*.log "$HOME"/.bashd/.submit-st*.lock 2>/dev/null
echo CLEANED''', 15)
    check("selftest cleanup", t_cleanup)

    os.environ["BASHD_HOME"] = os.path.expanduser("~/.bashd")
    set_home(os.environ["BASHD_HOME"])
    shutil.rmtree(tmp, ignore_errors=True)
    npass = sum(1 for _, ok, _ in results if ok)
    nskip = 1 if any("SKIP" in (msg or "") for _, _, msg in results) else 0
    print("\n%d/%d passed%s" % (npass, len(results) - nskip,
                                " (+1 skipped: no tmux)" if nskip else ""))
    return 0 if npass == len(results) - nskip else 1


def main():
    os.makedirs(HOME_DIR, exist_ok=True)
    args = build_parser().parse_args()
    try:
        args.fn(args)
    except BashdError as e:
        eprint("error: %s" % e)
        sys.exit(e.code)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
