TERM_ATTACH_BYTES = 4096     # history tail shown at attach

_TERM_HELP = ("~. detach | ~l live input | ~t turn (line) input | ~i info | ~~ literal tilde "
              "(turn: as a line + Enter; live: first keys after a fresh line, ssh-style)")


def _term_decide_mode(want, samples, kind, local):
    """auto: live (raw passthrough) when the link is healthy; turn (local line
    editor, only Enter/Ctrl-C cross the network) when it is not."""
    if want in ("live", "turn"):
        return want
    ss = sorted(x for x in samples if x is not None)
    if not ss:
        return "turn"
    med = ss[len(ss) // 2]
    if kind == "wire":
        return "live" if med < 0.7 else "turn"
    return "live" if local or med < 0.25 else "turn"


class _LineEditor:
    """Turn-mode input: local line editing (history, ctrl-a/e/u/w/k, arrows) so
    a bad link never taxes editing. Draws on the terminal's last line; the app
    hides it before writing remote output and re-shows it after."""

    _ESCS = (b"\x1b[A", b"\x1b[B", b"\x1b[C", b"\x1b[D", b"\x1b[H", b"\x1b[F",
             b"\x1b[1~", b"\x1b[4~", b"\x1b[3~", b"\x1b[5~", b"\x1b[6~",
             b"\x1bOA", b"\x1bOB", b"\x1bOC", b"\x1bOD", b"\x1bOH", b"\x1bOF",
             b"\x1b[200~", b"\x1b[201~")

    def __init__(self, term):
        self.term = term
        self.buf = ""
        self.pos = 0
        self.hist = []
        self.hi = 0
        self.draft = ""
        self.visible = False
        self.pend = b""
        self.run = b""
        self.dec = codecs.getincrementaldecoder("utf-8")("replace")

    def show(self):
        self.visible = True
        self.render()

    def hide(self):
        if self.visible:
            os.write(1, b"\r\x1b[K")
        self.visible = False

    def render(self):
        if not self.visible:
            return
        out = b"\r\x1b[K" + self.buf.encode("utf-8", "replace")
        if 0 < self.pos < len(self.buf):
            out += b"\r\x1b[%dC" % (self.pos + 1)
        os.write(1, out)

    def clear(self):
        self.buf = ""
        self.pos = 0
        self.render()

    def insert(self, text):
        self.buf = self.buf[:self.pos] + text + self.buf[self.pos:]
        self.pos += len(text)
        self.render()

    # ---- key handling ----

    def feed(self, data):
        if self.pend:
            data = self.pend + data
            self.pend = b""
        i, n = 0, len(data)
        while i < n:
            b = data[i]
            if b == 0x1B:
                seq = self._esc(data, i)
                if seq is None:  # incomplete escape sequence — wait for more
                    self.pend = data[i:]
                    if len(self.pend) > 16:
                        self.pend = b""
                    self._flush_run()
                    return
                self._flush_run()
                self._esc_action(seq)
                i += len(seq)
                continue
            if b < 0x20 or b == 0x7F:
                self._flush_run()
                self._ctl(b)
                i += 1
                continue
            self.run += data[i:i + 1]
            i += 1
        self._flush_run()

    def _flush_run(self):
        if self.run:
            text = self.dec.decode(self.run)
            self.run = b""
            if text:
                self.insert(text)

    def _esc(self, data, i):
        rest = data[i:]
        for s in self._ESCS:
            if rest.startswith(s):
                return s
        if any(s.startswith(rest) for s in self._ESCS):
            return None
        return b"\x1b"  # unknown sequence — swallow the ESC byte

    def _esc_action(self, seq):
        t = seq[1:]
        if t in (b"[A", b"OA"):
            self._hist_prev()
        elif t in (b"[B", b"OB"):
            self._hist_next()
        elif t in (b"[C", b"OC"):
            self.pos = min(len(self.buf), self.pos + 1)
            self.render()
        elif t in (b"[D", b"OD"):
            self.pos = max(0, self.pos - 1)
            self.render()
        elif t in (b"[H", b"[1~", b"OH"):
            self.pos = 0
            self.render()
        elif t in (b"[F", b"[4~", b"OF"):
            self.pos = len(self.buf)
            self.render()
        elif t == b"[3~":
            if self.pos < len(self.buf):
                self.buf = self.buf[:self.pos] + self.buf[self.pos + 1:]
                self.render()
        # pageup/pagedown/paste markers: ignored

    def _ctl(self, b):
        if b in (0x0D, 0x0A):
            self._enter()
        elif b in (0x7F, 0x08):
            if self.pos > 0:
                self.buf = self.buf[:self.pos - 1] + self.buf[self.pos:]
                self.pos -= 1
                self.render()
        elif b == 0x03:
            self.term.ctrl_c()
        elif b == 0x04:
            self.term.ctrl_d()
        elif b == 0x01:
            self.pos = 0
            self.render()
        elif b == 0x05:
            self.pos = len(self.buf)
            self.render()
        elif b == 0x02:
            self.pos = max(0, self.pos - 1)
            self.render()
        elif b == 0x06:
            self.pos = min(len(self.buf), self.pos + 1)
            self.render()
        elif b == 0x15:
            self.buf = self.buf[self.pos:]
            self.pos = 0
            self.render()
        elif b == 0x0B:
            self.buf = self.buf[:self.pos]
            self.render()
        elif b == 0x17:
            i = self.pos
            while i > 0 and self.buf[i - 1] == " ":
                i -= 1
            while i > 0 and self.buf[i - 1] != " ":
                i -= 1
            self.buf = self.buf[:i] + self.buf[self.pos:]
            self.pos = i
            self.render()
        elif b == 0x0C:
            os.write(1, b"\x1b[H\x1b[2J")
            self.render()
        elif b == 0x09:
            self.insert("\t")

    def _enter(self):
        line = self.buf
        self.hide()
        self.buf = ""
        self.pos = 0
        self.hi = len(self.hist)
        if line and (not self.hist or self.hist[-1] != line):
            self.hist.append(line)
        self.term.submit_line(line)

    def _hist_prev(self):
        if not self.hist:
            return
        if self.hi == len(self.hist):
            self.draft = self.buf
        self.hi = max(0, self.hi - 1)
        self.buf = self.hist[self.hi]
        self.pos = len(self.buf)
        self.render()

    def _hist_next(self):
        if self.hi >= len(self.hist):
            return
        self.hi += 1
        self.buf = self.hist[self.hi] if self.hi < len(self.hist) else self.draft
        self.pos = len(self.buf)
        self.render()


class _ExecBackend:
    """Per-call ssh transport (the classic one): same UX as the wire backend,
    higher latency — every poll and every input flush is an exec_script call."""
    kind = "exec"

    def __init__(self, host, sess, emit):
        self.host, self.sess, self.emit = host, sess, emit
        self.cursor = 0
        self.alive = True
        self.rtt = None
        self._q = collections.deque()
        self._qw = 0
        self._qcond = threading.Condition()
        self._stop = False

    def attach(self, cursor):
        self.cursor = cursor
        self.alive = True
        self._stop = False
        threading.Thread(target=self._poll_loop, daemon=True,
                         name="bashd-term-poll").start()
        threading.Thread(target=self._flush_loop, daemon=True,
                         name="bashd-term-flush").start()

    def detach(self):
        self._stop = True
        with self._qcond:
            self._qcond.notify_all()

    def reattach(self, cursor):
        self.cursor = cursor
        self.alive = True

    def _poll_loop(self):
        idle = 0
        was_err = False
        while not self._stop:
            t0 = time.time()
            try:
                r = tty_read(self.host, self.sess, self.cursor, 16384)
                d = time.time() - t0
                self.rtt = d if self.rtt is None else self.rtt * 0.7 + d * 0.3
                if was_err:
                    was_err = False
                    self.emit("net", ("recovered", None))
                if r["stdout_b"]:
                    self.cursor = r["cursor"]
                    self.emit("out", r["stdout_b"])
                    idle = 0
                else:
                    idle += 1
                if not r["alive"]:
                    if self.alive:
                        self.alive = False
                        self.emit("gone", None)
                    while not self._stop and not self.alive:
                        time.sleep(0.4)
                    continue
            except (Unreachable, BashdError) as e:
                was_err = True
                self.emit("net", ("dead", str(e)))
                time.sleep(2.0)
                continue
            base = 0.12 if self.host.local else max(0.15, min(1.0, (self.rtt or 0.2) * 1.25))
            time.sleep(base if idle < 3 else min(2.0, base * 3))

    def write(self, data):
        data = data.replace(b"\x00", b"")
        if not data:
            return
        with self._qcond:
            if self._qw + len(data) > 262144:
                self.emit("net", ("input-dropped", len(data)))
                return
            self._q.append(data)
            self._qw += len(data)
            self._qcond.notify_all()

    def _flush_loop(self):
        while not self._stop:
            with self._qcond:
                while not self._stop and not self._q:
                    self._qcond.wait(0.5)
                if self._stop:
                    return
                merged = b"".join(self._q)
                self._q.clear()
                self._qw = 0
            time.sleep(0.015)  # small merge window for burst typing
            with self._qcond:
                if self._q:
                    merged += b"".join(self._q)
                    self._q.clear()
                    self._qw = 0
            try:
                tty_write(self.host, self.sess, merged.decode("utf-8", "replace"),
                          append_newline=False)
            except (Unreachable, BashdError) as e:
                self.emit("net", ("dead", str(e)))

    def signal_int(self):
        try:
            tty_signal(self.host, self.sess, "ctrl-c")
        except (Unreachable, BashdError) as e:
            self.emit("net", ("dead", str(e)))

    def resize(self, cols, rows):
        script = ("tmux -L bashd set-option -w -t %s window-size manual >/dev/null 2>&1; "
                  "tmux -L bashd resize-window -t %s -x %d -y %d >/dev/null 2>&1; "
                  "echo BASHD_RESULT ok" % (self.sess, self.sess, cols, rows))
        try:
            exec_script(self.host, script, timeout_s=15)
        except BashdError:
            pass

    def latency_samples(self):
        out = []
        for _ in range(2):
            t0 = time.time()
            try:
                tty_read(self.host, self.sess, self.cursor, 1)
                out.append(time.time() - t0)
            except BashdError:
                pass
        return out


class _WireBackend:
    """The v0.4 wire transport backend. push flavor: output arrives as agent
    pushes (echo latency ~= RTT). poll flavor: an R-poll loop at ~link rate."""
    kind = "wire"

    def __init__(self, chan, sess, emit, push):
        self.chan, self.sess, self.emit, self.push = chan, sess, emit, push
        self.cursor = 0
        self._stop = False
        if not push:
            threading.Thread(target=self._poll_loop, daemon=True,
                             name="bashd-term-wirepoll").start()

    def attach(self, cursor):
        self.cursor = cursor
        self.chan.sub(self.sess, cursor, self._on_data)

    def detach(self):
        self._stop = True
        self.chan.unsub(self.sess)

    def reattach(self, cursor):
        self.cursor = cursor
        self.chan.sub(self.sess, cursor, self._on_data)

    def _on_data(self, data):
        if data is None:
            self.emit("gone", None)
            return
        self.cursor += len(data)
        self.emit("out", data)

    def _poll_loop(self):
        while not self._stop:
            try:
                r = self.chan.read(self.sess, self.cursor, WIRE_PUSH_MAX)
            except BashdError:
                time.sleep(1.0)
                continue
            if r["data"]:
                self._on_data(r["data"])
            if not r["alive"]:
                self._on_data(None)
                time.sleep(1.0)
                continue
            time.sleep(max(0.1, min(0.8, (self.chan.rtt or 0.2))))

    def write(self, data):
        self.chan.write(self.sess, data)

    def signal_int(self):
        self.chan.signal(self.sess, "int")

    def resize(self, cols, rows):
        self.chan.resize(self.sess, cols, rows)

    def latency_samples(self):
        out = [self.chan.ping() for _ in range(3)]
        return [x for x in out if x is not None] or [9.9]


class _TermApp:
    """The human terminal. One main loop: select() on stdin (user input) and a
    self-pipe (remote output, net events, SIGWINCH); only the main thread ever
    touches the screen, so the editor never races the output stream."""

    def __init__(self, host, sess, want_mode, use_wire, scrollback):
        self.host, self.sess = host, sess
        self.want_mode = want_mode
        self.use_wire = use_wire
        self.scrollback = scrollback
        self.mode = None
        self.running = True
        self.gone = False
        self.drop_times = []
        self.bytes_out = 0
        self.t0 = time.time()
        self.editor = _LineEditor(self)
        self.backend = None
        self.chan = None
        self._q = collections.deque()
        self._qr, self._qwfd = os.pipe()
        for fd in (self._qr, self._qwfd):
            fcntl.fcntl(fd, fcntl.F_SETFL, fcntl.fcntl(fd, fcntl.F_GETFL) | os.O_NONBLOCK)
        self._saved_term = None
        self._old_winch = self._old_term = None
        self._cols = self._rows = None
        self._resize_at = 0.0
        self._live_at_bol = True
        self._hold_tilde = False
        self._last_out_nl = True

    def emit(self, kind, data):  # any thread
        self._q.append((kind, data))
        try:
            os.write(self._qwfd, b"x")
        except OSError:
            pass

    # ---- lifecycle ----

    def run(self):
        self._raw_on()
        try:
            self._attach()
            while self.running:
                timeout = self._select_timeout()
                try:
                    r, _, _ = select.select([0, self._qr], [], [], timeout)
                except InterruptedError:
                    continue
                if 0 in r:
                    bs = os.read(0, 8192)
                    if not bs:
                        break
                    self._feed(bs)
                if self._qr in r:
                    try:
                        while os.read(self._qr, 256):
                            pass
                    except OSError:
                        pass
                    self._drain()
                if not r:
                    if self._hold_tilde:  # lone '~' at line start, no follow-up
                        self._hold_tilde = False
                        self._forward_live(b"~")
                if self._resize_at and time.time() >= self._resize_at:
                    self._do_resize()
        finally:
            self._teardown()

    def _attach(self):
        t0 = time.time()
        probe = tty_read(self.host, self.sess, 0, 1)
        probe_s = time.time() - t0
        start_cursor = max(0, probe["size"] - self.scrollback)
        if self.use_wire:
            try:
                self.chan = WireChannel(self.host,
                                        on_event=lambda k, i: self.emit("net", (k, i)))
                self.chan.connect()
                self.backend = _WireBackend(self.chan, self.sess, self.emit, self.chan.push)
            except (Unreachable, BashdError):
                self.chan = None
        if self.backend is None:
            self.backend = _ExecBackend(self.host, self.sess, self.emit)
            self.backend.rtt = probe_s
        self._do_resize(force=True)  # remote pane matches the local terminal
        self._dim("bashd %s term — host=%s session=%s transport=%s — %s" % (
            VERSION, self.host.name, self.sess,
            ("wire/%s" % ("push" if self.chan.push else "poll")) if self.chan else "ssh-per-call",
            _TERM_HELP))
        first = self._pull(start_cursor, 262144)
        if first:
            if start_cursor > 0:  # snap the history tail to a line start
                nl = first.find(b"\n")
                if 0 <= nl < len(first) - 1:
                    first = first[nl + 1:]
            self._write_out(first)
        samples = self.backend.latency_samples()
        self.set_mode(_term_decide_mode(self.want_mode, samples,
                                        self.backend.kind, self.host.local))
        self.backend.attach(probe["size"])

    def _teardown(self):
        try:
            self.editor.hide()
        except Exception:
            pass
        if self._saved_term is not None:
            try:
                termios.tcsetattr(0, termios.TCSANOW, self._saved_term)
            except termios.error:
                pass
        try:
            self.backend.detach()
        except Exception:
            pass
        if self.chan:
            self.chan.close()
        for s, h in ((_signal.SIGWINCH, self._old_winch), (_signal.SIGTERM, self._old_term)):
            if h is not None:
                try:
                    _signal.signal(s, h)
                except Exception:
                    pass
        for fd in (self._qr, self._qwfd):
            try:
                os.close(fd)
            except OSError:
                pass

    def _raw_on(self):
        self._saved_term = termios.tcgetattr(0)
        tty.setraw(0)
        self._old_winch = _signal.getsignal(_signal.SIGWINCH)
        self._old_term = _signal.getsignal(_signal.SIGTERM)
        _signal.signal(_signal.SIGWINCH, lambda *a: self.emit("winch", None))
        _signal.signal(_signal.SIGTERM, lambda *a: self.emit("quit", None))

    # ---- helpers ----

    def _select_timeout(self):
        if self._hold_tilde:
            return 0.35
        if self._resize_at:
            return max(0.01, self._resize_at - time.time())
        return None

    def _dim(self, s):
        os.write(1, b"\r\x1b[K\x1b[2m" + s.encode("utf-8", "replace") + b"\x1b[0m\r\n")
        self._last_out_nl = True
        if self.mode == "turn":
            self.editor.show()

    def _write_out(self, bs):
        os.write(1, bs)
        self.bytes_out += len(bs)
        self._last_out_nl = bs[-1:] in (b"\n", b"\r")

    def _ensure_fresh_line(self):
        if not self._last_out_nl:
            os.write(1, b"\r\n")
            self._last_out_nl = True

    def _pull(self, cursor, mx):
        try:
            if self.chan:
                return self.chan.read(self.sess, cursor, mx)["data"]
            return tty_read(self.host, self.sess, cursor, mx)["stdout_b"]
        except (Unreachable, BashdError):
            return b""

    def _do_resize(self, force=False):
        self._resize_at = 0.0
        try:
            rows, cols, _, _ = struct.unpack("HHHH",
                                             fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8))
        except OSError:
            return
        if not force and (cols, rows) == (self._cols, self._rows):
            return
        self._cols, self._rows = cols, rows
        self.backend.resize(cols, rows)

    def set_mode(self, m, why=""):
        if m == self.mode:
            return
        self.mode = m
        if m == "turn":
            self._ensure_fresh_line()
            self.editor.show()
        else:
            self.editor.hide()
        self._dim("input mode: %s%s" % (m, " (%s)" % why if why else ""))

    # ---- input paths ----

    def _feed(self, bs):
        if self.mode == "live":
            self._feed_live(bs)
        else:
            self.editor.feed(bs)

    def _feed_live(self, bs):
        bs = bs.replace(b"\x00", b"")
        if not bs:
            return
        if self._hold_tilde:
            self._hold_tilde = False
            if self._live_escape(bs[:1]):
                if len(bs) > 1:
                    self._forward_live(bs[1:])
                return
            self._forward_live(b"~" + bs)
            return
        if self._live_at_bol and bs[:1] == b"~":  # ssh-style escapes at BOL
            if len(bs) == 1:
                self._hold_tilde = True
                return
            if self._live_escape(bs[1:2]):
                if len(bs) > 2:
                    self._forward_live(bs[2:])
                return
        self._forward_live(bs)

    def _live_escape(self, c):
        """Handle a tilde escape in live mode. True if consumed locally."""
        if c == b".":
            self.running = False
        elif c == b"t":
            self.set_mode("turn", "escape")
        elif c == b"i":
            self._info_line()
        elif c == b"l":
            self._dim("already in live input mode")
        else:
            return False
        return True

    def _forward_live(self, bs):
        self.backend.write(bs)
        self._live_at_bol = bs[-1:] in (b"\r", b"\n")

    def submit_line(self, line):
        if line.startswith("~") and len(line) >= 2 and line[1] in ".ilth":
            c = line[1]
            if c == ".":
                self.running = False
            elif c == "i":
                self._info_line()
            elif c == "l":
                self.set_mode("live", "forced")
            elif c == "t":
                self.set_mode("turn", "forced")
            elif c == "h":
                self._dim(_TERM_HELP)
            return
        if line.startswith("~~"):
            line = line[1:]
        if self.gone:
            self._recreate()
            if self.gone:
                self._dim("line dropped (session still gone) — press Up to recover it")
                return
        self.backend.write((line + "\r").encode("utf-8", "replace"))

    def ctrl_c(self):
        self.editor.clear()
        if not self.gone:
            self.backend.signal_int()

    def _info_line(self):
        rtt = (self.chan.rtt if self.chan and self.chan.rtt
               else getattr(self.backend, "rtt", None))
        self._dim("mode=%s transport=%s rtt=%s drops=%d out=%dB gone=%s | %s" % (
            self.mode,
            ("wire/%s" % ("push" if self.chan.push else "poll")) if self.chan
            else "ssh-per-call",
            ("%.0f ms" % (rtt * 1000)) if rtt else "?",
            self.chan.drops if self.chan else 0, self.bytes_out, self.gone,
            _TERM_HELP))

    def ctrl_d(self):
        if not self.editor.buf:
            self.running = False
        elif self.editor.pos < len(self.editor.buf):
            self.editor.buf = (self.editor.buf[:self.editor.pos]
                               + self.editor.buf[self.editor.pos + 1:])
            self.editor.render()

    def _recreate(self):
        self._dim("session gone — recreating (env resets)…")
        try:
            session_ensure(self.host, self.sess)
            r0 = tty_read(self.host, self.sess, 0, 1)
        except (Unreachable, BashdError) as e:
            self._dim("recreate failed: %s" % str(e)[:160])
            return
        self.backend.reattach(r0["size"])
        self.gone = False

    # ---- event drain (main thread only) ----

    def _drain(self):
        while self._q:
            kind, data = self._q.popleft()
            if kind == "out":
                self._write_out(data)
                if self.mode == "turn" and self.running:
                    self._ensure_fresh_line()
                    self.editor.show()
            elif kind == "gone":
                self.gone = True
                self._dim("session ended (exit or killed) — the next command recreates it")
            elif kind == "net":
                self._net_event(*data)
            elif kind == "winch":
                self._resize_at = time.time() + 0.25  # debounce
            elif kind == "quit":
                self.running = False

    def _net_event(self, k, info):
        if k == "dead":
            self._dim("link down (%s) — reconnecting…" % str(info)[:140])
            self.drop_times.append(time.time())
            self.drop_times = [t for t in self.drop_times if time.time() - t < 120]
            if (self.mode == "live" and self.want_mode == "auto"
                    and len(self.drop_times) >= 2):
                self.set_mode("turn", "auto: repeated link drops")
        elif k == "reconnected":
            self._dim("link back (path %s, flavor %s) — resumed from cursor, nothing lost"
                      % (info.get("path"), info.get("flavor")))
        elif k == "recovered":
            self._dim("link back (per-call transport)")
        elif k == "input-dropped":
            self._dim("warning: %s unacked input bytes dropped — retype if missing" % info)
        elif k == "agent-msg":
            self._dim(str(info)[:160])
        elif info is not None:
            self._dim("%s: %s" % (k, str(info)[:140]))


def run_term(host, session="main", mode="auto", use_wire=True, scrollback=TERM_ATTACH_BYTES):
    """Human terminal on a persistent session. Turn-based by nature (line
    editor; only Enter/Ctrl-C cross the network), an ordinary terminal over a
    good link (raw passthrough + pushed deltas). Detaching leaves the session
    alive on the target."""
    if termios is None:
        raise BashdError("term needs a POSIX terminal (termios)")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise BashdError("term needs a tty on stdin and stdout")
    sess = _check_sess_name(session)
    t0 = time.time()
    while True:
        try:
            session_ensure(host, sess)
            break
        except Unreachable as e:
            if time.time() - t0 > 300:
                raise
            print("waiting for %s (%s) — retrying, Ctrl-C to give up…"
                  % (host.name, str(e)[:120]))
            time.sleep(2)
    app = _TermApp(host, sess, mode, use_wire, scrollback)
    app.run()
    dt = int(time.time() - app.t0)
    print("\x1b[2m— detached after %ds · %d bytes streamed · %d link drops · "
          "session '%s' lives on (`bashd term %s --session %s` reattaches) —\x1b[0m"
          % (dt, app.bytes_out, app.chan.drops if app.chan else 0, sess, host.name, sess))
    return {"ok": True, "host": host.name, "session": sess, "duration_s": dt,
            "bytes_out": app.bytes_out}


