def mcp_dispatch(name, args):
    hosts = load_config()
    if name == "bash_hosts":
        return do_paths(args.get("host"), bool(args.get("repath")))
    if name == "bash_sessions":
        return do_sessions(args.get("host"), hosts)
    if name == "bash_prune":
        h = get_host(args.get("host", "local"), hosts)
        return do_prune(h, h.name, stale_s=args.get("stale_s"))
    if name == "bash_run":
        h = get_host(args.get("host", "local"), hosts)
        return do_run(h, args["cmd"], float(args.get("timeout_s", 120)),
                      int(args.get("max_bytes", DEFAULT_MAX_BYTES)),
                      args.get("cwd"), args.get("env"), args.get("id"),
                      session=args.get("session", "main"))
    if name == "bash_start":
        h = get_host(args.get("host", "local"), hosts)
        return do_start(h, args.get("cmd"), args.get("mode", "batch"), args.get("name"),
                        args.get("cwd"), args.get("env"), args.get("id"),
                        session=args.get("session"))
    if name == "bash_read":
        host, kind, key = parse_id(args["id"])
        return do_read(host, kind, key, int(args.get("cursor_out", 0)),
                       int(args.get("cursor_err", 0)),
                       int(args.get("max_bytes", DEFAULT_MAX_BYTES)),
                       bool(args.get("screen")))
    if name == "bash_wait":
        host, kind, key = parse_id(args["id"])
        return do_wait(host, kind, key, float(args.get("timeout_s", 120)),
                       args.get("until", "exit"), args.get("pattern"),
                       float(args.get("idle_s", 2.0)),
                       int(args.get("max_bytes", DEFAULT_MAX_BYTES)),
                       bool(args.get("until_reachable")))
    if name == "bash_write":
        host, kind, key = parse_id(args["id"])
        return do_write(host, kind, key, args["data"], args.get("append_newline", True))
    if name == "bash_signal":
        host, kind, key = parse_id(args["id"])
        return do_signal(host, kind, key, args.get("sig", "TERM"))
    raise NotFound("unknown tool %r" % name)


def mcp_server():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if not isinstance(msg, dict):
            continue
        mid, method = msg.get("id"), msg.get("method")
        if not method or mid is None:
            continue  # notification or garbage
        try:
            if method == "initialize":
                pv = msg.get("params", {}).get("protocolVersion") or MCP_PROTOCOL_VERSION
                result = {"protocolVersion": pv,
                          "capabilities": {"tools": {}},
                          "serverInfo": {"name": "bashd", "version": VERSION}}
            elif method == "tools/list":
                result = {"tools": mcp_tools()}
            elif method == "tools/call":
                p = msg.get("params", {})
                try:
                    r = mcp_dispatch(p.get("name", ""), p.get("arguments") or {})
                    result = {"content": [{"type": "text", "text": json.dumps(r, ensure_ascii=False)}],
                              "isError": False}
                except BashdError as e:
                    result = {"content": [{"type": "text", "text": json.dumps(
                        {"ok": False, "error": str(e), "code": e.code})}], "isError": True}
                except Exception as e:  # noqa: BLE001 — report, never crash the server
                    result = {"content": [{"type": "text", "text": json.dumps(
                        {"ok": False, "error": "%s: %s" % (type(e).__name__, e)})}], "isError": True}
            elif method == "ping":
                result = {}
            else:
                _respond(mid, None, {"code": -32601, "message": "method not found: %s" % method})
                continue
            _respond(mid, result, None)
        except Exception as e:  # noqa: BLE001
            _respond(mid, None, {"code": -32603, "message": str(e)})


def _respond(mid, result, error):
    msg = {"jsonrpc": "2.0", "id": mid}
    if error:
        msg["error"] = error
    else:
        msg["result"] = result
    sys.stdout.write(json.dumps(msg, ensure_ascii=False) + "\n")
    sys.stdout.flush()


